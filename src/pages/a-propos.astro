---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import aboutPortrait from "../assets/about-chandra-josephus.webp";
import aboutLandscape from "../assets/pages/landscape.webp";
import Icon from "../components/ui/Icon.astro";
import { aboutPageContent } from "../data/site-content";
---

<Layout
  title={aboutPageContent.meta.title}
  description={aboutPageContent.meta.description}
>
  <div class="about-page">
    <div class="about-page__stack max-w-(--site-max-width) mx-auto px-4">
      <section class="section-shell about-page__hero">
        <figure class="about-page__hero-media about-page__media-card about-page__media-card--hero">
          <div class="about-page__media-frame">
            <Image
              src={aboutPortrait}
              alt={aboutPageContent.hero.portraitAlt}
              class="about-page__portrait"
              widths={[480, 720, 960]}
              sizes="(max-width: 767px) 100vw, 30vw"
              loading="eager"
              format="webp"
            />
            <figcaption class="about-page__media-caption about-page__media-caption--hero">{aboutPageContent.hero.portraitCaption}</figcaption>
          </div>
        </figure>

        <header class="about-page__hero-header">
          <p class="section-label">{aboutPageContent.hero.label}</p>
          <h1 class="text-3xl sm:text-5xl font-semibold tracking-tight">
            {aboutPageContent.hero.titleParts ? (
              aboutPageContent.hero.titleParts.map((part) => (
                <span class:list={{
                  "u-text-gradient": part.highlight,
                  "text-(--accent-primary)": part.accent,
                }}>
                  {part.text}
                </span>
              ))
            ) : (
              aboutPageContent.hero.title
            )}
          </h1>
        </header>

        <div class="about-page__hero-body">
          <div class="about-page__hero-copy">
            {aboutPageContent.hero.paragraphs.map((paragraph, index) => (
              <p class={index === 0 ? "text-base sm:text-lg text-(--color-muted) leading-relaxed" : "text-sm sm:text-base text-(--color-muted) leading-relaxed"}>
                {paragraph}
              </p>
            ))}

            <div class="about-page__skills about-page__skills--hero">
              <p class="about-page__skills-label">{aboutPageContent.expertise.skillsLabel}</p>
              <ul class="about-page__skills-list">
                {aboutPageContent.expertise.skills.map((skill) => (
                  <li class="about-page__skill-pill">{skill}</li>
                ))}
              </ul>
            </div>
          </div>

          <aside class="about-page__hero-highlights" aria-label="Repères">
            <p class="about-page__hero-aside-label">{aboutPageContent.hero.highlightsLabel}</p>
            <ul class="about-page__highlight-list">
              {aboutPageContent.hero.highlights.map((item) => (
                <li>
                  <span class="about-highlight-list__icon about-page__highlight-icon">
                    <Icon name={item.icon} />
                  </span>
                  <span>{item.label}</span>
                </li>
              ))}
            </ul>
          </aside>
        </div>

        <a href={aboutPageContent.hero.ctaHref} class="about-page__hero-cta section-link section-link--inline">
          <span>{aboutPageContent.hero.ctaLabel}</span>
          <Icon name="arrow" />
        </a>
      </section>

      <section id={aboutPageContent.story.id} class="section-shell about-page__panel about-page__panel--story">
        <div class="about-page__section-intro">
          <p class="about-page__section-index">{aboutPageContent.story.index}</p>
          <div class="section-copy-stack">
            <h2 class="text-2xl sm:text-4xl font-semibold tracking-tight">{aboutPageContent.story.title}</h2>
            <p class="text-sm sm:text-base text-(--color-muted) leading-relaxed">
              {aboutPageContent.story.intro}
            </p>
            {aboutPageContent.story.paragraphs.map((paragraph) => (
              <p class="text-sm sm:text-base text-(--color-muted) leading-relaxed">
                {paragraph}
              </p>
            ))}
          </div>
        </div>

        <figure class="about-page__story-media about-page__media-card">
          <div class="about-page__media-frame">
            <Image
              src={aboutLandscape}
              alt={aboutPageContent.story.imageAlt}
              class="about-page__story-image"
              widths={[640, 960, 1280]}
              sizes="(max-width: 1023px) 100vw, 36vw"
              loading="lazy"
              format="webp"
            />
            <figcaption class="about-page__media-caption">{aboutPageContent.story.imageCaption}</figcaption>
          </div>
        </figure>

        <aside class="project-case-study__overview-shell about-page__story-skills" aria-label={aboutPageContent.story.technicalSkillsLabel}>
          <p class="project-case-study__group-label">{aboutPageContent.story.technicalSkillsLabel}</p>
          <dl class="project-case-study__overview">
            <div class="project-case-study__overview-item about-page__soft-rule">
              <dt class="project-case-study__label">Repères</dt>
              <dd>
                <ul class="about-page__skills-list">
                  {aboutPageContent.story.technicalSkills.map((skill) => (
                    <li class="about-page__skill-pill">{skill}</li>
                  ))}
                </ul>
              </dd>
            </div>
          </dl>
        </aside>
      </section>

      <section class="section-shell about-page__panel about-page__panel--expertise">
        <div class="about-page__section-intro">
          <p class="about-page__section-index">{aboutPageContent.expertise.index}</p>
          <div class="section-copy-stack">
            <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight">{aboutPageContent.expertise.title}</h2>
            <p class="text-sm sm:text-base text-(--color-muted) leading-relaxed">
              {aboutPageContent.expertise.intro}
            </p>
          </div>
        </div>

        <div class="about-page__expertise-grid">
          <div class="about-page__expertise-points">
            {aboutPageContent.expertise.points.map((item) => (
              <article class="about-page__expertise-point about-page__soft-rule">
                <h3 class="text-base font-semibold">{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))}
          </div>

        </div>
      </section>

      <section class="section-shell about-page__quote" aria-label="Citation repere">
        <div class="about-page__quote-shell">
          <span class="about-page__quote-icon" aria-hidden="true">
            <Icon name="quote" />
          </span>
          <p class="about-page__quote-label">{aboutPageContent.quote.label}</p>
          <blockquote class="about-page__quote-text">
            <p>{aboutPageContent.quote.text}</p>
          </blockquote>
          <p class="about-page__quote-attribution">{aboutPageContent.quote.attribution}</p>
        </div>
      </section>

      <section class="section-shell about-page__panel about-page__panel--process">
        <div class="about-page__section-intro">
          <p class="about-page__section-index">{aboutPageContent.process.index}</p>
          <div class="section-copy-stack">
            <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight">{aboutPageContent.process.title}</h2>
            <p class="text-sm sm:text-base text-(--color-muted) leading-relaxed">
              {aboutPageContent.process.intro}
            </p>
          </div>
        </div>

        <ol class="about-page__process-grid">
          {aboutPageContent.process.steps.map((step, index) => (
            <li class="about-page__process-item">
              <p class="about-page__process-index">0{index + 1}</p>
              <h3 class="text-base font-semibold">{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))}
        </ol>
        <p class="text-xs sm:text-sm text-(--color-muted) leading-relaxed max-w-2xl mt-6">
          {aboutPageContent.process.note}
        </p>
      </section>

      <section class="section-shell about-page__panel about-page__panel--inspiration">
        <div class="about-page__section-intro">
          <p class="about-page__section-index">{aboutPageContent.inspiration.index}</p>
          <div class="section-copy-stack">
            <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight">{aboutPageContent.inspiration.title}</h2>
            <p class="text-sm sm:text-base text-(--color-muted) leading-relaxed">
              {aboutPageContent.inspiration.intro}
            </p>
          </div>
        </div>

        <div class="about-page__inspiration-grid">
          {aboutPageContent.inspiration.items.map((item) => (
            <p class="about-page__soft-rule">{item}</p>
          ))}
        </div>
      </section>

    </div>
  </div>
</Layout>
