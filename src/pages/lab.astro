---
import Layout from "../layouts/Layout.astro";
import { journalCategories, labItems } from "../data/site-content";
---

<Layout
  title="Journal UX/UI, WordPress, Shopify, Astro, SEO et IA générative"
  description="Journal REKODE : réflexions de fond sur UX/UI, contenu, direction artistique, WordPress, Shopify, Astro, intégration Front-End, IA générative, SEO et accessibilité."
>
  <section class="section-shell">
    <div class="max-w-5xl mx-auto px-4 space-y-8">
      <header class="section-header">
        <p class="section-label">Journal</p>
        <h1 class="text-3xl sm:text-4xl font-semibold">Réflexions de fond et retours d'expérience</h1>
        <p class="text-sm sm:text-base text-[var(--color-muted)]">
          Un espace pour documenter les méthodes, décisions et explorations qui nourrissent les projets REKODE.
        </p>
      </header>

      <div class="project-grid project-grid--services">
        {labItems.map((item) => (
          <article class="card-elevated section-card">
            <h2 class="text-lg font-semibold">{item.title}</h2>
            <p class="text-sm text-[var(--color-muted)]">{item.summary}</p>
          </article>
        ))}
      </div>

      <div class="project-grid project-grid--services">
        {journalCategories.map((category) => (
          <article class="audience-item u-soft-rule has-hover-fx" id={category.slug}>
            <h2 class="text-lg font-semibold">{category.label}</h2>
            <p class="text-sm text-[var(--color-muted)]">{category.summary}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
