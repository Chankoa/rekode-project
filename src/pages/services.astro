---
import Layout from "../layouts/Layout.astro";
import SelectedProjects from "../components/sections/SelectedProjects.astro";
import Process from "../components/sections/Process.astro";
import Icon from "../components/ui/Icon.astro";
import {
  selectedProjects,
  type ProcessStep,
  type IconName,
} from "../data/site-content";

interface OfferItem {
  title: string;
  icon: IconName;
  lead: string;
  text: string;
  price: string;
}

const offers: OfferItem[] = [
  {
    title: "Diagnostic & plan d'action",
    icon: "document",
    lead: "Pour clarifier un besoin avant de refaire un site.",
    text: "Prendre du recul sur un site existant, un message ou une idée avant d'engager du temps ou un budget.",
    price: "À partir de 149 €",
  },
  {
    title: "Création & refonte de site vitrine",
    icon: "monitor",
    lead: "Pour créer une présence web vivante et simple à faire évoluer.",
    text: "Concevoir un site cohérent avec une activité, un public et un message. De la structure au contenu, avec une attention portée à l'expérience.",
    price: "À partir de 790 € / sur devis selon périmètre",
  },
    {
    title: "Création de boutique e-commerce Shopify",
    icon: "monitor",
    lead: "Pour vendre en ligne avec une boutique pensée pour votre activité et vos clients.",
    text: "Conception UX/UI, personnalisation Shopify, structuration du catalogue, optimisation des fiches produits et accompagnement jusqu'à la mise en ligne.",
    price: "À partir de 1490 € / sur devis selon périmètre",
  },
  {
    title: "Accompagnement & regard extérieur",
    icon: "ear",
    lead: "Pour débloquer une idée ou avancer avec méthode.",
    text: "Un temps d'échange pour clarifier un besoin, structurer une réflexion ou avancer sur un site, un contenu ou une problématique web.",
    price: "Session 1h30 à partir de 90 €",
  },
];

const audiences: Array<{ label: string; icon: IconName; text: string }> = [
  {
    label: "Hébergements touristiques",
    icon: "leaf",
    text: "Pour clarifier une offre, rassurer avant la réservation et faire vivre le site au quotidien.",
  },
  {
    label: "Activités outdoor & tourisme",
    icon: "mountain",
    text: "Pour présenter l'expérience, la saisonnalité et les informations utiles sans brouiller le parcours.",
  },
  {
    label: "Indépendants, artisans, thérapeutes",
    icon: "heart",
    text: "Pour poser un cadre simple, crédible et humain autour d'une activité souvent portée seule.",
  },
  {
    label: "Formateurs & organismes de formation",
    icon: "cap",
    text: "Pour structurer une offre lisible, organiser les contenus et aider les publics à comprendre rapidement ce qui est proposé.",
  },
];

const methodSteps: ProcessStep[] = [
  {
    title: "Comprendre",
    description: "Écouter votre contexte, vos contraintes et les vrais enjeux du projet.",
    icon: "ear",
  },
  {
    title: "Clarifier",
    description: "Identifier ce qui bloque dans le message, l'offre ou le parcours utilisateur.",
    icon: "spark",
  },
  {
    title: "Structurer",
    description: "Organiser les contenus, les priorités et les actions attendues.",
    icon: "document",
  },
  {
    title: "Concevoir",
    description: "Transformer la stratégie en pages lisibles, sobres et rassurantes.",
    icon: "pen",
  },
  {
    title: "Accompagner",
    description: "Vous aider à comprendre, ajuster et faire vivre votre présence web.",
    icon: "heart",
  },
];

const faqItems = [
  {
    question: "Travaillez-vous uniquement avec le tourisme ?",
    answer:
      "Non. Le tourisme, l'outdoor et les hébergements font partie des contextes que je connais bien, mais j'accompagne aussi les indépendants, artisans, thérapeutes, formateurs et tout type de structures et domaine d'activité.",
  },
  {
    question: "Faut-il déjà avoir un site ?",
    answer:
      "Non. Je peux intervenir pour cadrer un futur site, clarifier une offre ou faire évoluer une présence existante.",
  },
  {
    question: "Est-ce que vous travaillez à distance ?",
    answer:
      "Oui. Les diagnostics, accompagnements et phases de conception peuvent se faire à distance, avec des échanges simples et structurés.",
  },
  {
    question: "Pouvez-vous intervenir uniquement sur une page ou un problème précis ?",
    answer:
      "Oui. Une session d'accompagnement peut suffire pour débloquer une page, un parcours, un problème WordPress, un sujet SEO ou une question de contenu.",
  },
  {
    question: "Comment savoir quelle offre choisir ?",
    answer:
      "Si le besoin est flou, le diagnostic est souvent le bon point de départ. Si le site est daté ou confus, la refonte est indiquée. Pour une difficulté ponctuelle, l'accompagnement suffit souvent.",
  },
];
---

<Layout
  title="Services"
  description="REKODE accompagne les indépendants, petites structures, acteurs du tourisme et projets avec des offres web claires, concrètes et humaines."
>
  <section class="section-shell">
    <div class="services-hero max-w-(--site-max-width) mx-auto px-4">
      <header class="services-hero__content section-header">
        <p class="section-label">Services</p>
        <h1 class="text-3xl sm:text-5xl font-semibold tracking-tight">
          <span class="u-text-gradient">Optimiser</span> votre <span class="u-text-gradient">présence</span> sur le web, créer une <span class="u-text-gradient">expérience utilisateur</span> impactante.
        </h1>
        <p class="text-sm sm:text-base text-(--color-muted) leading-relaxed max-w-3xl">
          Vous cherchez à créer un site web pour développer votre activité, vous souhaitez maintenir, changer le design ou optimiser le référencement de votre site actuel : REKODE vous accompagne et réalise votre projet.
        </p>
        <div class="hero__actions pt-2">
          <a href="/contact" class="btn-primary">Parler de votre projet</a>
        </div>
      </header>

      <aside class="services-hero__visual" aria-hidden="true">
        <div class="services-hero__manifesto-visual">
          <div class="services-hero__circle services-hero__circle--outer"></div>
          <div class="services-hero__circle services-hero__circle--middle"></div>
          <div class="services-hero__circle services-hero__circle--inner"></div>
        </div>

        <div class="services-hero__manifesto-content">
          <p class="services-hero__eyebrow services-hero__eyebrow--create">Créer</p>
          <p class="services-hero__eyebrow services-hero__eyebrow--share">Partager</p>
          <p class="services-hero__eyebrow services-hero__eyebrow--creative">Rester créatif</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="section-shell">
    <div class="services-page section-stack--airy max-w-(--site-max-width) mx-auto px-4">
      <header class="section-heading-row">
        <div class="section-header">
          <p class="section-label">Pour qui ?</p>
          <h2 class="text-2xl sm:text-3xl md:text-4xl font-semibold">Le web pour tous.</h2>
          <p class="text-(--color-muted) text-sm sm:text-base leading-relaxed">
           Le web est en mouvement permanent, et les techniques utlisées pour réaliser un projet numérique évoluent, mais l'objectif demeure identique : créer une expérience utilisateur optimale dans le but de promouvoir une, ou plusieurs activités.
          </p>
          <p class="text-(--color-muted) text-sm sm:text-base leading-relaxed">
            L'accompagnement proposé s'adresse à tous types de projets dont le but est de produire un site clair et attractif, en accord avec vos valeurs et objectifs. Quelques exemples :
          </p>
        </div>
      </header>

      <div class="service-grid">
        {audiences.map((audience) => (
          <article class="audience-item u-soft-rule has-hover-fx">
            <span class="service-item__icon">
              <Icon name={audience.icon} />
            </span>
            <h3 class="text-base sm:text-lg font-semibold">{audience.label}</h3>
            <p class="text-sm text-(--color-muted) leading-relaxed">{audience.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-shell">
    <div class="services-page section-stack--airy max-w-(--site-max-width) mx-auto px-4">
      <header class="section-heading-row">
        <div class="section-header">
          <p class="section-label">Services</p>
          <h2 class="text-2xl sm:text-3xl md:text-4xl font-semibold">Quel est votre projet ?</h2>
          <p class="text-(--color-muted) text-sm sm:text-base leading-relaxed">
            Vous avez besoin de conseil sur l'optimisation de votre site web, vous souhaitez créer, ou refondre un site vitrine, vous avez un projet de boutique en ligne : voici quelques-unes de mes propositions.
          </p>
        </div>
      </header>

      <div class="service-grid">
        {offers.map((offer) => (
          <article class="service-item service-item--offer has-hover-fx">
            <span class="service-item__icon"><Icon name={offer.icon} /></span>
            <h3 class="text-base sm:text-lg font-semibold">{offer.title}</h3>
            <p class="text-sm text-(--color-muted) leading-relaxed">{offer.lead}</p>
            <p class="text-sm text-(--color-muted) leading-relaxed">{offer.text}</p>
            <p class="text-sm font-semibold text-(--color-text) leading-relaxed">{offer.price}</p>
          </article>
        ))}
      </div>

      <a href="/contact" class="section-link section-link--inline">
        <span>Parler de votre projet</span>
        <Icon name="arrow" />
      </a>
    </div>
  </section>

  <Process
    label="Méthode"
    title="Une méthode simple"
    intro="L'objectif n'est pas de complexifier votre présence web, mais de clarifier les décisions et de prioriser les actions utiles."
    steps={methodSteps}
  />

  <SelectedProjects
    label="Projets"
    title="Quelques projets "
    intro="Des exemples de sites et d'interventions où la clarté du parcours, le contenu et la crédibilité ont compté autant que la technique."
    projects={selectedProjects.slice(0, 4)}
    showProjectsLink={true}
  />

  <section class="section-shell">
    <div class="max-w-(--site-max-width) mx-auto px-4 section-stack--airy">
      <header class="section-header">
        <p class="section-label">FAQ</p>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-semibold">Questions fréquentes</h2>
      </header>

      <div class="faq-list">
        {faqItems.map((item) => (
          <details class="faq-item u-soft-rule">
            <summary class="faq-item__summary">
              <span class="faq-item__question text-base sm:text-lg font-semibold">{item.question}</span>
              <span class="faq-item__toggle" aria-hidden="true">
                <span class="faq-item__toggle-line faq-item__toggle-line--horizontal"></span>
                <span class="faq-item__toggle-line faq-item__toggle-line--vertical"></span>
              </span>
            </summary>
            <div class="faq-item__answer">
              <p class="text-sm text-(--color-muted) leading-relaxed">{item.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

</Layout>
