---
import Layout from "../layouts/Layout.astro";
import SelectedProjects from "../components/sections/SelectedProjects.astro";
import Process from "../components/sections/Process.astro";
import PageCta from "../components/sections/PageCta.astro";
import Icon from "../components/ui/Icon.astro";
import {
  selectedProjects,
  type ProcessStep,
  type IconName,
} from "../data/site-content";

interface OfferItem {
  title: string;
  icon: IconName;
  lead: string;
  text: string;
  price: string;
}

const offers: OfferItem[] = [
  {
    title: "Audit & stratégie digitale",
    icon: "document",
    lead: "Pour cadrer une direction avant de créer, refondre ou optimiser.",
    text: "Analyse de votre présence numérique, clarification des objectifs, publics, contenus, parcours, SEO et priorités d'action.",
    price: "À partir de 149 €",
  },
  {
    title: "Création & refonte de site professionnel",
    icon: "monitor",
    lead: "Pour transformer une activité en site clair, utile et évolutif.",
    text: "Conception web, architecture de contenu, UX/UI, direction artistique, intégration Front-End, WordPress ou Astro, mise en ligne et prise en main.",
    price: "À partir de 790 € / sur devis selon périmètre",
  },
  {
    title: "Shopify & expérience d'achat",
    icon: "shopping",
    lead: "Pour concevoir une boutique qui aide vraiment à choisir et acheter.",
    text: "Shopify, catalogue produits, fiches articles, récit de marque, UX/UI, contenus de réassurance, optimisation mobile et accompagnement à la mise en ligne.",
    price: "À partir de 1490 € / sur devis selon périmètre",
  },
  {
    title: "Accompagnement stratégique",
    icon: "ear",
    lead: "Pour avancer avec méthode sur un sujet précis ou dans la durée.",
    text: "Conseil, UX/UI, architecture de contenu, WordPress, Shopify, SEO, IA générative, arbitrages techniques ou accompagnement de mise en ligne.",
    price: "Session 1h30 à partir de 90 €",
  },
];

const formats: Array<{ label: string; icon: IconName; text: string }> = [
  {
    label: "Cadrage",
    icon: "document",
    text: "Une phase courte pour comprendre le contexte, identifier les priorités et poser un plan d'action exploitable.",
  },
  {
    label: "Conception complète",
    icon: "monitor",
    text: "Une mission de bout en bout, de la stratégie à la mise en ligne, avec contenus, interface et intégration.",
  },
  {
    label: "Refonte ciblée",
    icon: "refresh",
    text: "Une intervention sur une base existante pour clarifier l'offre, améliorer les parcours ou renforcer le SEO.",
  },
  {
    label: "Conseil continu",
    icon: "cap",
    text: "Un accompagnement ponctuel ou régulier pour arbitrer, débloquer, documenter et faire évoluer le projet.",
  },
];

const methodSteps: ProcessStep[] = [
  {
    title: "Vous partagez le contexte",
    description: "Nous passons en revue l'offre, les publics, les contraintes, les outils et les éléments déjà disponibles.",
    icon: "ear",
  },
  {
    title: "Nous choisissons les priorités",
    description: "Nous décidons ce que le site doit faire comprendre et l'action qu'il doit faciliter : choisir, contacter, réserver ou acheter.",
    icon: "spark",
  },
  {
    title: "Vous suivez la conception",
    description: "Les pages, textes et interactions sont présentés à des moments utiles pour recueillir vos retours sans ralentir la mission.",
    icon: "pen",
  },
  {
    title: "Vous recevez une base exploitable",
    description: "Le résultat est testé sur mobile et desktop, documenté et transmis avec les repères nécessaires à sa maintenance.",
    icon: "cap",
  },
];

const faqItems = [
  {
    question: "Travaillez-vous uniquement avec le tourisme ?",
    answer:
      "Non. Le tourisme, l'outdoor et les hébergements font partie des contextes que je connais bien, mais j'accompagne aussi les indépendants, artisans, thérapeutes, formateurs et tout type de structures et domaine d'activité.",
  },
  {
    question: "Faut-il déjà avoir un site ?",
    answer:
      "Non. Je peux intervenir pour cadrer un futur site, clarifier une offre ou faire évoluer une présence existante.",
  },
  {
    question: "Est-ce que vous travaillez à distance ?",
    answer:
      "Oui. Les diagnostics, accompagnements et phases de conception peuvent se faire à distance, avec des échanges simples et structurés.",
  },
  {
    question: "Pouvez-vous intervenir uniquement sur une page ou un problème précis ?",
    answer:
      "Oui. Une session d'accompagnement peut suffire pour débloquer une page, un parcours, un problème WordPress, un sujet SEO ou une question de contenu.",
  },
  {
    question: "Comment savoir quelle offre choisir ?",
    answer:
      "Si le besoin est flou, le diagnostic est souvent le bon point de départ. Si le site est daté ou confus, la refonte est indiquée. Pour une difficulté ponctuelle, l'accompagnement suffit souvent.",
  },
];
---

<Layout
  title="Services de conception web, UX/UI, WordPress, Shopify et Astro"
  description="Services REKODE pour création de site professionnel, refonte de site, UX/UI, architecture de contenu, Shopify, WordPress, Astro et intégration Front-End."
>
  <section class="section-shell">
    <div class="services-hero max-w-(--site-max-width) mx-auto px-4">
      <header class="services-hero__content section-header">
        <p class="section-label">Services</p>
        <h1 class="text-3xl sm:text-5xl font-semibold tracking-tight">
          Créer ou refondre un <span class="u-text-gradient">site professionnel</span> comme une expérience numérique.
        </h1>
        <p class="text-sm sm:text-base text-(--color-muted) leading-relaxed max-w-3xl">
          Audit, création, refonte ou accompagnement ciblé : chaque format répond à un moment différent, de la mise au point de l'offre jusqu'à la mise en ligne.
        </p>
      </header>

      <aside class="services-hero__visual" aria-hidden="true">
        <div class="services-hero__manifesto-visual">
          <div class="services-hero__circle services-hero__circle--outer"></div>
          <div class="services-hero__circle services-hero__circle--middle"></div>
          <div class="services-hero__circle services-hero__circle--inner"></div>
        </div>

        <div class="services-hero__manifesto-content">
          <p class="services-hero__eyebrow services-hero__eyebrow--create">Clarifier</p>
          <p class="services-hero__eyebrow services-hero__eyebrow--share">Structurer</p>
          <p class="services-hero__eyebrow services-hero__eyebrow--creative">Concevoir</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="section-shell">
    <div class="services-page section-stack--airy max-w-(--site-max-width) mx-auto px-4">
      <header class="section-heading-row">
        <div class="section-header">
          <p class="section-label">Philosophie</p>
          <h2 class="text-2xl sm:text-3xl md:text-4xl font-semibold">Commencer par ce qui doit être compris.</h2>
          <p class="text-(--color-muted) text-sm sm:text-base leading-relaxed">
            Les outils changent vite, mais les enjeux restent stables : rendre une offre lisible, aider un public à se repérer, raconter ce qui fait la singularité d'un projet et construire une interface fiable.
          </p>
          <p class="text-(--color-muted) text-sm sm:text-base leading-relaxed">
            L'accompagnement peut prendre plusieurs formes selon le moment du projet : cadrer, concevoir, refondre, optimiser ou simplement avancer avec un regard extérieur structuré.
          </p>
        </div>
      </header>

      <div class="service-grid">
        {formats.map((format) => (
          <article class="audience-item u-soft-rule has-hover-fx">
            <span class="service-item__icon">
              <Icon name={format.icon} />
            </span>
            <h3 class="text-base sm:text-lg font-semibold">{format.label}</h3>
            <p class="text-sm text-(--color-muted) leading-relaxed">{format.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-shell">
    <div class="services-page section-stack--airy max-w-(--site-max-width) mx-auto px-4">
      <header class="section-heading-row">
        <div class="section-header">
          <p class="section-label">Services</p>
          <h2 class="text-2xl sm:text-3xl md:text-4xl font-semibold">Prestations</h2>
          <p class="text-(--color-muted) text-sm sm:text-base leading-relaxed">
            Les formats ci-dessous servent de point de départ. Le périmètre précis dépend du contexte, du niveau de contenu existant, des choix techniques et de l'accompagnement souhaité.
          </p>
        </div>
      </header>

      <div class="service-grid">
        {offers.map((offer) => (
          <article class="service-item service-item--offer has-hover-fx">
            <span class="service-item__icon"><Icon name={offer.icon} /></span>
            <h3 class="text-base sm:text-lg font-semibold">{offer.title}</h3>
            <p class="text-sm text-(--color-muted) leading-relaxed">{offer.lead}</p>
            <p class="text-sm text-(--color-muted) leading-relaxed">{offer.text}</p>
            <p class="text-sm font-semibold text-(--color-text) leading-relaxed">{offer.price}</p>
          </article>
        ))}
      </div>

    </div>
  </section>

  <Process
    label="Déroulement"
    title="Comment se déroule une mission"
    intro="Vous savez ce qui est attendu, quand intervenir et ce qui vous sera remis à la fin de la mission."
    steps={methodSteps}
  />

  <SelectedProjects
    label="Projets"
    title="Quelques études de cas"
    intro="Des exemples où la clarté du parcours, le contenu, la crédibilité, le SEO et la technique ont compté autant que l'interface."
    projects={selectedProjects.slice(0, 4)}
    showProjectsLink={true}
  />

  <section class="section-shell">
    <div class="max-w-(--site-max-width) mx-auto px-4 section-stack--airy">
      <header class="section-header">
        <p class="section-label">FAQ</p>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-semibold">Questions fréquentes</h2>
      </header>

      <div class="faq-list">
        {faqItems.map((item) => (
          <details class="faq-item u-soft-rule">
            <summary class="faq-item__summary">
              <span class="faq-item__question text-base sm:text-lg font-semibold">{item.question}</span>
              <span class="faq-item__toggle" aria-hidden="true">
                <span class="faq-item__toggle-line faq-item__toggle-line--horizontal"></span>
                <span class="faq-item__toggle-line faq-item__toggle-line--vertical"></span>
              </span>
            </summary>
            <div class="faq-item__answer">
              <p class="text-sm text-(--color-muted) leading-relaxed">{item.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <PageCta
    title="Quel format correspond à votre projet ?"
    intro="Décrivez le besoin et l'état d'avancement : je vous indiquerai le format pertinent ou les informations à réunir d'abord."
    ctaLabel="Présenter le contexte"
  />

</Layout>
