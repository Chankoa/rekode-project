---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/ui/Icon.astro";
import PageCta from "../components/sections/PageCta.astro";
import { journalCategories } from "../data/site-content";
---

<Layout
  title="Journal UX/UI, WordPress, Shopify, Astro, SEO et IA générative"
  description="Journal REKODE : réflexions de fond sur UX/UI, architecture de contenu, WordPress, Shopify, Astro, intégration Front-End, IA générative, SEO et accessibilité."
>
  <section class="section-shell">
    <div class="projects-page__hero max-w-(--site-max-width) mx-auto px-4">
      <header class="projects-page__hero-content section-header">
        <p class="section-label">Journal</p>
        <h1 class="text-3xl sm:text-5xl font-semibold tracking-tight">
          Des notes sur les choix qui façonnent <span class="u-text-gradient">un site utile</span>.
        </h1>
        <p class="text-sm sm:text-base text-(--color-muted) leading-relaxed max-w-3xl">
          Le Journal accueillera des retours de projet et des notes de pratique. Il est encore en construction ; les premiers articles seront publiés progressivement.
        </p>
      </header>

      <aside class="projects-page__hero-aside" aria-label="Intentions éditoriales">
        <p class="projects-page__hero-kicker">Ligne éditoriale</p>
        <ul class="projects-page__hero-points">
          <li>
            <span class="projects-page__hero-icon"><Icon name="document" /></span>
            <span>Documenter les méthodes, décisions et arbitrages.</span>
          </li>
          <li>
            <span class="projects-page__hero-icon"><Icon name="spark" /></span>
            <span>Relier design, contenu, technique et usage réel.</span>
          </li>
          <li>
            <span class="projects-page__hero-icon"><Icon name="cap" /></span>
            <span>Partager ce qui peut être réutilisé dans un autre contexte.</span>
          </li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section-shell">
    <div class="services-page section-stack--airy max-w-(--site-max-width) mx-auto px-4">
      <header class="section-heading-row">
        <div class="section-header">
          <p class="section-label">En préparation</p>
          <h2 class="text-2xl sm:text-3xl md:text-4xl font-semibold">Quatre axes, avant les premiers articles</h2>
          <p class="text-(--color-muted) text-sm sm:text-base leading-relaxed">
            Aucun catalogue artificiel : ces ensembles serviront uniquement à classer les publications lorsqu'elles seront disponibles.
          </p>
        </div>
      </header>

      <div class="service-grid">
        {journalCategories.map((item) => (
          <article class="service-item service-item--offer has-hover-fx" id={item.slug}>
            <span class="service-item__icon"><Icon name="pen" /></span>
            <h3 class="text-base sm:text-lg font-semibold">{item.label}</h3>
            <p class="text-sm text-(--color-muted) leading-relaxed">{item.summary}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <PageCta
    title="Une réflexion à prolonger dans un projet ?"
    intro="Si une question éditoriale, ergonomique ou technique se pose déjà, décrivez-la avec son contexte."
    ctaLabel="Partager la question"
  />
</Layout>
