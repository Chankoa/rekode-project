---
import Layout from "../../layouts/Layout.astro";
import SelectedProjects from "../../components/sections/SelectedProjects.astro";
import PageCta from "../../components/sections/PageCta.astro";
import Icon from "../../components/ui/Icon.astro";
import { selectedProjects } from "../../data/site-content";
---

<Layout
  title="Études de cas UX/UI, Shopify, WordPress, Astro et Front-End"
  description="Études de cas REKODE : création de site professionnel, refonte de site, UX/UI, architecture de contenu, WordPress, Shopify, Astro, SEO et intégration Front-End."
>
  <section class="section-shell">
    <div class="projects-page__hero max-w-(--site-max-width) mx-auto px-4">
      <header class="projects-page__hero-content section-header">
        <p class="section-label">Études de cas</p>
        <h1 class="text-3xl sm:text-5xl font-semibold tracking-tight">
          Des études de cas centrées sur les <span class="u-text-gradient">décisions utiles</span>.
        </h1>
        <p class="text-sm sm:text-base text-(--color-muted) leading-relaxed max-w-3xl">
          Chaque cas présente un contexte, les choix réalisés et leur effet sur la compréhension de l'offre, la confiance, la prise de contact ou l'achat.
        </p>
        <div class="hero__actions pt-2">
          <a href="#liste-etudes" class="btn-primary">Voir les projets</a>
          <a href="/methode" class="btn-secondary">Comprendre la méthode</a>
        </div>
      </header>

      <aside class="projects-page__hero-aside" aria-label="Repères de lecture">
        <p class="projects-page__hero-kicker">Lecture des cas</p>
        <ul class="projects-page__hero-points">
          <li>
            <span class="projects-page__hero-icon"><Icon name="document" /></span>
            <span>Contexte, objectif, approche et décisions de conception.</span>
          </li>
          <li>
            <span class="projects-page__hero-icon"><Icon name="monitor" /></span>
            <span>Technologies, contenus, interface, CMS et intégration Front-End.</span>
          </li>
          <li>
            <span class="projects-page__hero-icon"><Icon name="heart" /></span>
            <span>Résultat et retour d'expérience pour documenter les arbitrages.</span>
          </li>
        </ul>
      </aside>
    </div>
  </section>

  <div id="liste-etudes">
    <SelectedProjects
      label="Projets"
      title="Les études de cas"
      intro="MIMOSA, Maison Alta, Sens Dessus Dessous, ROCKSIDERS, La Fabrique et LearnIt Forge montrent des interventions où la conception dépasse la simple création d'un site."
      projects={selectedProjects}
      showProjectsLink={false}
    />
  </div>

  <PageCta
    title="Un projet à transformer ?"
    intro="Présentez la situation actuelle, ce qui freine les visiteurs et le résultat attendu."
    ctaLabel="Décrire le projet"
  />
</Layout>
