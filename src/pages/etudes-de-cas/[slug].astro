---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/ui/Icon.astro";
import { selectedProjects, type ProjectItem } from "../../data/site-content";

interface Props {
  project: ProjectItem;
}

export function getStaticPaths() {
  return selectedProjects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props as Props;
const caseStudy = project.caseStudy;
const overview = caseStudy?.overview;
const cta = caseStudy?.cta;
const assetExtensionPattern = /\.(avif|webp|png|jpe?g)$/i;

const buildAssetMap = (modules: Record<string, { default: ImageMetadata }>) =>
  new Map(
    Object.entries(modules)
      .map(([path, asset]) => {
        const fileName = path.split("/").pop();
        const slug = fileName?.replace(assetExtensionPattern, "");

        return slug ? [slug, asset.default] : null;
      })
      .filter((entry): entry is [string, ImageMetadata] => Boolean(entry)),
  );

const projectThumbnailModules = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/projects/*.{avif,webp,png,jpg,jpeg}",
  { eager: true },
);

const projectCaseStudyImageModules = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/projects/case-studies/*.{avif,webp,png,jpg,jpeg}",
  { eager: true },
);

const projectThumbnailMap = buildAssetMap(projectThumbnailModules);
const projectCaseStudyImageMap = buildAssetMap(projectCaseStudyImageModules);
const thumbnail = projectThumbnailMap.get(project.slug);
const caseStudyImage = projectCaseStudyImageMap.get(project.slug) ?? thumbnail;

const readingSections = [
  { label: "Contexte", text: caseStudy?.context ?? project.summary },
  { label: "Objectif", text: caseStudy?.objective ?? project.summary },
  { label: "Approche", text: caseStudy?.approach ?? project.summary },
  { label: "Décisions de conception", text: caseStudy?.decisions ?? overview?.deliverables ?? project.summary },
  { label: "Technologies", text: caseStudy?.technologies ?? overview?.stack ?? project.tags.join(" · ") },
  { label: "Résultat", text: caseStudy?.result ?? caseStudy?.outcome ?? project.summary },
  { label: "Retour d'expérience", text: caseStudy?.retrospective ?? caseStudy?.outcome ?? project.summary },
];
---

<Layout
  title={`${project.title} | Étude de cas conception web et UX/UI`}
  description={project.summary}
>
  <section class="section-shell">
    <div class="project-case-study-page max-w-(--site-max-width) mx-auto px-4 section-stack--airy">
      <header class="section-header">
        <a href="/etudes-de-cas" class="section-link section-link--inline">
          <Icon name="arrow" />
          <span>Retour aux études de cas</span>
        </a>
        <p class="section-label">Étude de cas</p>
        <h1 class="text-3xl sm:text-5xl font-semibold tracking-tight">
          {project.title}
        </h1>
        <p class="text-sm sm:text-base text-(--color-muted) leading-relaxed">
          {project.summary}
        </p>
      </header>

      <article id={project.slug} class={`project-case-study project-card--${project.slug}`}>
        <div class="project-case-study__hero">
          <div class="project-case-study__media">
            <div
              class="project-case-study__visual"
              style={caseStudyImage ? `--project-case-study-aspect-ratio: ${caseStudyImage.width} / ${caseStudyImage.height};` : undefined}
            >
              <div class="project-case-study__frame">
                {caseStudyImage ? (
                  <Image
                    src={caseStudyImage}
                    alt={project.thumbnailAlt ?? `Aperçu du projet ${project.title}`}
                    class="project-case-study__image"
                    widths={[720, 1080, 1440]}
                    sizes="(max-width: 1023px) 100vw, 52vw"
                    loading="eager"
                    format="webp"
                  />
                ) : (
                  <div class="project-card__screen project-card__screen--placeholder"></div>
                )}

                <div class="project-card__visual-overlay" aria-hidden="true"></div>
              </div>
            </div>
          </div>

          <div class="project-case-study__content space-y-6">
            <div class="project-case-study__header">
              <div class="project-case-study__heading-row">
                <div class="space-y-3">
                  <p class="project-case-study__index" aria-hidden="true">{project.meta}</p>
                  <h2 class="text-2xl sm:text-3xl font-semibold">{project.title}</h2>
                  {project.websiteHref && (
                    <a
                      href={project.websiteHref}
                      class="project-case-study__site-link section-link"
                      target="_blank"
                      rel="noreferrer"
                    >
                      <span>{project.websiteLabel ?? "Voir le site"}</span>
                      <Icon name="arrow" />
                    </a>
                  )}
                  {cta && (
                    <a href={cta.href} class="project-case-study__cta section-link section-link--inline">
                      <span>{cta.label}</span>
                      <Icon name="arrow" />
                    </a>
                  )}
                </div>
              </div>

              {overview && (
                <div class="project-case-study__overview-shell">
                  <p class="project-case-study__group-label">Repères projet</p>
                  <dl class="project-case-study__overview" aria-label="Repères projet">
                    <div class="project-case-study__overview-item about-page__soft-rule">
                      <dt class="project-case-study__label">Rôle</dt>
                      <dd>{overview.role}</dd>
                    </div>
                    <div class="project-case-study__overview-item about-page__soft-rule">
                      <dt class="project-case-study__label">Livrables</dt>
                      <dd>{overview.deliverables}</dd>
                    </div>
                    <div class="project-case-study__overview-item about-page__soft-rule">
                      <dt class="project-case-study__label">Technologies</dt>
                      <dd>{overview.stack}</dd>
                    </div>
                    {overview.timeline && (
                      <div class="project-case-study__overview-item about-page__soft-rule">
                        <dt class="project-case-study__label">Cadre</dt>
                        <dd>{overview.timeline}</dd>
                      </div>
                    )}
                  </dl>
                </div>
              )}
            </div>
          </div>
        </div>

        <div class="project-case-study__sections-shell">
          <p class="project-case-study__group-label">Lecture du projet</p>
          <div class="project-case-study__sections">
            {readingSections.map((section) => (
              <section class="project-case-study__section about-page__soft-rule">
                <p class="project-case-study__label">{section.label}</p>
                <p>{section.text}</p>
              </section>
            ))}
          </div>
        </div>
      </article>
    </div>
  </section>
</Layout>
