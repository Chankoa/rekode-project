---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/sections/Hero.astro";
import SelectedProjects from "../components/sections/SelectedProjects.astro";
import Services from "../components/sections/Services.astro";
import Process from "../components/sections/Process.astro";
import PageCta from "../components/sections/PageCta.astro";
import { homeProcessSteps, selectedProjects, services } from "../data/site-content";
---

<Layout
  title="Conception web, UX/UI et expériences numériques"
  description="REKODE conçoit des expériences numériques pour la création de site professionnel, la refonte de site, l'UX/UI, WordPress, Shopify, Astro et l'intégration Front-End."
>
  <Hero />

  <section class="section-shell" aria-label="Fil conducteur REKODE">
    <div class="max-w-(--site-max-width) mx-auto px-4">
      <div class="section-header max-w-4xl">
        <p class="section-label">Manifeste</p>
        <h2 class="text-2xl sm:text-3xl font-semibold">
          Un site est utile lorsqu'il aide à comprendre, choisir et agir.
        </h2>
        <p class="text-(--color-muted) text-sm sm:text-base leading-relaxed max-w-2xl">
          Le point de départ reste l'usage : présenter une offre sans détour, donner les bons repères et faciliter une prise de contact, une réservation ou un achat.
        </p>
      </div>
    </div>
  </section>

  <Services label="Services" services={services} showServicesLink={true} servicesLinkLabel="Voir les services" />

  <Process
    label="Aperçu de la méthode"
    title="Clarifier, structurer, concevoir"
    intro="Trois gestes pour passer du besoin aux pages utiles, puis choisir une solution technique que l'équipe pourra faire vivre."
    steps={homeProcessSteps}
    linkHref="/methode/"
    linkLabel="Voir la méthode complète"
  />

  <SelectedProjects label="Études de cas" projects={selectedProjects.slice(0, 4)} />

  <PageCta
    title="Votre projet commence peut-être par une conversation."
    intro="Présentez le contexte, ce qui existe déjà et la décision que le site doit faciliter."
    ctaLabel="Échanger sur le projet"
  />
</Layout>
