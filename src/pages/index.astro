---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/sections/Hero.astro";
import SelectedProjects from "../components/sections/SelectedProjects.astro";
import Services from "../components/sections/Services.astro";
import Process from "../components/sections/Process.astro";
import About from "../components/sections/About.astro";
import { processSteps, selectedProjects, services } from "../data/site-content";
---

<Layout title="Accueil">
  <Hero />

  <SelectedProjects label="Réalisations" projects={selectedProjects} />

  <Services label="Services" services={services} showServicesLink={true} />

  <Process label="Approche" steps={processSteps} />

  <About />
</Layout>
