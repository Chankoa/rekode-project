---
import Layout from "../layouts/Layout.astro";
import SelectedProjects from "../components/sections/SelectedProjects.astro";
import { selectedProjects } from "../data/site-content";
---

<Layout title="Projets">
  <SelectedProjects
    title="Projets"
    intro="Des réalisations et prototypes qui servent de démonstrateurs pour le niveau de finition, la méthode et la variété des contextes traités."
    projects={selectedProjects}
    showProjectsLink={false}
    variant="case-studies"
  />
</Layout>