---
import Layout from "../layouts/Layout.astro";
import Process from "../components/sections/Process.astro";
import SelectedProjects from "../components/sections/SelectedProjects.astro";
import PageCta from "../components/sections/PageCta.astro";
import Icon from "../components/ui/Icon.astro";
import { processSteps, selectedProjects } from "../data/site-content";

const methodDetails = [
  {
    title: "Comprendre",
    text: "Chaque mission commence par une lecture du contexte : activité, publics, contraintes, objectifs, contenus existants, outils en place et rôle attendu du site, de la boutique ou de l'interface.",
  },
  {
    title: "Clarifier",
    text: "Le travail consiste ensuite à faire émerger les messages prioritaires, les preuves à montrer, les actions attendues et les points de friction qui empêchent l'expérience d'être lisible.",
  },
  {
    title: "Structurer",
    text: "L'arborescence, les parcours, les contenus, les composants et les appels à l'action sont organisés pour créer une architecture compréhensible et durable.",
  },
  {
    title: "Concevoir",
    text: "La stratégie prend forme dans l'interface : UX/UI, direction artistique, rythme éditorial, intégration Front-End, WordPress, Shopify, Astro ou autre socle adapté au projet.",
  },
  {
    title: "Accompagner",
    text: "La mission se termine par la mise en ligne, la transmission des repères utiles, les ajustements prioritaires et l'accompagnement nécessaire pour faire vivre l'expérience dans le temps.",
  },
];
---

<Layout
  title="Méthode de conception web, UX/UI et architecture de contenu"
  description="La méthode REKODE en cinq étapes pour création de site professionnel, refonte de site, UX/UI, architecture de contenu, WordPress, Shopify, Astro et intégration Front-End."
>
  <section class="section-shell">
    <div class="projects-page__hero max-w-(--site-max-width) mx-auto px-4">
      <header class="projects-page__hero-content section-header">
        <p class="section-label">Méthode</p>
        <h1 class="text-3xl sm:text-5xl font-semibold tracking-tight">
          Donner un ordre clair aux <span class="u-text-gradient">décisions du projet</span>.
        </h1>
        <p class="text-sm sm:text-base text-(--color-muted) leading-relaxed max-w-3xl">
          Cinq étapes permettent de comprendre l'activité, hiérarchiser l'information, produire les pages puis transmettre une base fiable.
        </p>
        <div class="hero__actions pt-2">
          <a href="/etudes-de-cas" class="btn-secondary">Voir la méthode en situation</a>
        </div>
      </header>

      <aside class="projects-page__hero-aside" aria-label="Repères de méthode">
        <p class="projects-page__hero-kicker">Ce que la méthode évite</p>
        <ul class="projects-page__hero-points">
          <li>
            <span class="projects-page__hero-icon"><Icon name="spark" /></span>
            <span>Produire une interface avant d'avoir clarifié le message.</span>
          </li>
          <li>
            <span class="projects-page__hero-icon"><Icon name="document" /></span>
            <span>Empiler des contenus sans hiérarchie ni parcours utilisateur.</span>
          </li>
          <li>
            <span class="projects-page__hero-icon"><Icon name="code" /></span>
            <span>Choisir un outil technique sans tenir compte de l'usage réel.</span>
          </li>
        </ul>
      </aside>
    </div>
  </section>

  <Process
    label="Les 5 étapes"
    title="Comprendre, clarifier, structurer, concevoir, accompagner"
    intro="La méthode n'est pas un tunnel rigide. Elle donne un ordre aux décisions pour que la stratégie, les contenus, l'interface et la technique avancent ensemble."
    steps={processSteps}
  />

  <section class="section-shell">
    <div class="project-case-study-page max-w-(--site-max-width) mx-auto px-4 section-stack--airy">
      <header class="section-header">
        <p class="section-label">Détail</p>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-semibold">Ce que chaque étape produit</h2>
        <p class="text-(--color-muted) text-sm sm:text-base leading-relaxed">
          Chaque étape produit une décision vérifiable : une priorité, une arborescence, un écran, un test ou un repère de maintenance.
        </p>
      </header>

      <div class="project-case-study__sections">
        {methodDetails.map((step) => (
          <article class="project-case-study__section about-page__soft-rule">
            <p class="project-case-study__label">{step.title}</p>
            <p>{step.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <SelectedProjects
    label="Exemples"
    title="Des projets qui montrent la méthode"
    intro="MIMOSA, Maison Alta, ROCKSIDERS ou LearnIt Forge illustrent des interventions où le contenu, l'interface, le SEO, la technique et l'accompagnement dépassent la simple création d'un site."
    projects={selectedProjects.slice(0, 3)}
    showProjectsLink={true}
  />

  <PageCta
    title="Une idée à structurer ?"
    intro="Exposez le contexte et les contraintes : nous pourrons identifier la première décision à prendre."
    ctaLabel="Présenter l'idée"
  />
</Layout>
