---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Merci" description="Votre message a bien été envoyé.">
  <section class="section-shell">
    <div class="max-w-(--site-max-width) mx-auto px-4">
      <div class="section-header">
        <p class="section-label">Message envoyé</p>
        <h1 class="text-3xl sm:text-4xl font-semibold">Merci, votre message a bien été transmis.</h1>
        <p class="text-sm sm:text-base text-(--text-muted) max-w-2xl">
          Je reviens vers vous rapidement. En attendant, vous pouvez poursuivre la visite ou revenir à l'accueil.
        </p>
        <div class="hero__actions pt-2">
          <a href="/" class="btn-primary">Retour à l'accueil</a>
          <a href="/realisations" class="btn-secondary">Voir les réalisations</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
