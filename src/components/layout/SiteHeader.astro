---
import ThemeToggle from "./ThemeToggle.astro";
import { siteConfig } from "../../data/site-config";
import "../../styles/components/navigation.scss";
import "../../styles/components/site-header.scss";

const normalizePath = (path: string) => {
  if (!path || path === "/") return "/";
  return path.endsWith("/") ? path.slice(0, -1) : path;
};

const currentPath = normalizePath(Astro.url.pathname);
---

<header class="site-header sticky top-0 z-30 border-b border-transparent">
  <div class="site-header__inner mx-auto flex max-w-(--site-max-width) items-center justify-between gap-4 px-4 py-4">
    <a href="/" class="site-header__brand flex items-center gap-2 leading-none no-underline">
      <span style="font-family: var(--font-heading);" class="text-base font-bold tracking-[-0.04em] text-(--text-strong)">{siteConfig.name}<span class="text-(--accent-primary)">.</span></span>
    </a>

    <nav class="desktop-nav nav items-center gap-6 text-sm text-(--text-muted)">
      {siteConfig.navigation.map((item) => (
        <a
          href={item.href}
          class:list={{
            "nav-link px-1 py-1 rounded-full transition-colors": true,
            "is-active": normalizePath(item.href) === currentPath,
          }}
          aria-current={normalizePath(item.href) === currentPath ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
  
      <ThemeToggle />

      <button
        id="drawer-open"
        class="drawer-toggle inline-flex items-center justify-center text-(--text-strong)"
        aria-controls="mobile-drawer"
        aria-expanded="false"
        aria-label="Ouvrir le menu"
        type="button"
      >
        <span class="sr-only">Ouvrir le menu</span>
        <span class="drawer-toggle__icon" aria-hidden="true">
          <span class="drawer-toggle__bar"></span>
          <span class="drawer-toggle__bar"></span>
          <span class="drawer-toggle__bar"></span>
        </span>
      </button>
    </div>
  </div>
</header>

<div
  id="drawer-backdrop"
  class="fixed inset-0 bg-black/40 opacity-0 pointer-events-none transition z-40"
></div>

<aside
  id="mobile-drawer"
  class="drawer fixed inset-y-0 left-0 w-full max-w-none bg-(--surface-card) border-r border-(--border-soft) shadow-2xl z-50 flex flex-col p-6 gap-8"
  aria-label="Menu mobile"
>
  <div class="drawer-intro flex flex-col gap-3">
    <span class="drawer-intro__eyebrow">Menu</span>
    <a href="/" class="drawer-intro__brand flex items-center gap-2 no-underline" aria-label={`Retour à l'accueil ${siteConfig.name}`}>
      <span style="font-family: var(--font-heading);" class="text-lg font-bold tracking-tighter text-(--text-strong)">{siteConfig.name}<span class="text-(--accent-primary)">.</span></span>
    </a>
    <p class="drawer-intro__lede max-w-md text-sm leading-6 text-(--text-muted)">
      Explorer les services, les études de cas, la méthode, le journal ou prendre contact.
    </p>
  </div>

  <nav class="drawer-menu flex flex-col gap-2 text-sm text-(--text-muted) nav nav--stacked">
    {siteConfig.navigation.map((item) => (
      <a
        href={item.href}
        class:list={{
          "drawer-menu__item nav-link px-3 py-4 rounded-md transition-colors hover:bg-(--surface-muted) hover:text-(--text-strong)": true,
          "is-active": normalizePath(item.href) === currentPath,
        }}
        aria-current={normalizePath(item.href) === currentPath ? "page" : undefined}
      >
        {item.label}
      </a>
    ))}
  </nav>

  <div class="drawer-actions border-t border-(--border-soft) pt-6">
    <button
      id="theme-toggle-mobile"
      class="theme-mode-toggle w-full inline-flex items-center justify-between rounded-full border border-(--border-soft) px-3 py-2 text-sm font-semibold text-(--text-strong)"
      aria-label="Basculer le thème"
      aria-pressed="false"
      type="button"
    >
      <span class="theme-mode-toggle__switch" aria-hidden="true">
        <span class="theme-mode-toggle__tokens">
          <span id="theme-light-mobile" class="theme-mode-toggle__token is-active">L</span>
          <span id="theme-dark-mobile" class="theme-mode-toggle__token">D</span>
        </span>
        <span class="theme-mode-toggle__thumb">
          <span class="theme-mode-toggle__thumb-icon theme-mode-toggle__thumb-icon--sun">
            <svg viewBox="0 0 24 24" role="presentation">
              <path d="M12 3v2m0 14v2m9-9h-2M5 12H3m14.95 6.95-1.41-1.41M7.46 7.46 6.05 6.05m11.31 0-1.41 1.41M7.46 16.54l-1.41 1.41" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
              <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.8" fill="none" />
            </svg>
          </span>
          <span class="theme-mode-toggle__thumb-icon theme-mode-toggle__thumb-icon--moon">
            <svg viewBox="0 0 24 24" role="presentation">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none" />
            </svg>
          </span>
        </span>
      </span>
      <span id="theme-label-mobile" class="theme-mode-toggle__label">Clair</span>
    </button>
  </div>
</aside>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const STORAGE_KEY = "preferred-theme";
    const baseTheme = root.dataset.baseTheme || root.getAttribute("data-theme") || "default";
    let palette = baseTheme === "dark" ? "default" : baseTheme;

    const sun = document.getElementById("icon-sun");
    const moon = document.getElementById("icon-moon");
    const label = document.getElementById("theme-label");
    const lightM = document.getElementById("theme-light-mobile");
    const darkM = document.getElementById("theme-dark-mobile");
    const labelM = document.getElementById("theme-label-mobile");
    const desktopToggle = document.getElementById("theme-toggle");
    const mobileToggle = document.getElementById("theme-toggle-mobile");

    const applyTheme = (mode) => {
      const target = mode === "dark" ? "dark" : palette;
      root.dataset.theme = target;
      root.dataset.baseTheme = palette;
      localStorage.setItem(STORAGE_KEY, target === "dark" ? "dark" : palette);
      const isDark = target === "dark";
      desktopToggle?.setAttribute("aria-pressed", isDark ? "true" : "false");
      mobileToggle?.setAttribute("aria-pressed", isDark ? "true" : "false");
      if (sun && moon) {
        sun.classList.toggle("hidden", isDark);
        moon.classList.toggle("hidden", !isDark);
      }
      if (label) label.textContent = isDark ? "Mode sombre" : "Mode clair";
      if (lightM && darkM) {
        lightM.classList.toggle("is-active", !isDark);
        darkM.classList.toggle("is-active", isDark);
      }
      if (labelM) labelM.textContent = isDark ? "Sombre" : "Clair";
    };

    const initTheme = () => {
      const saved = localStorage.getItem(STORAGE_KEY);
      const prefersDark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
      const initial = (() => {
        if (saved === "dark") return "dark";
        if (saved && saved !== "default") {
          palette = saved;
          return palette;
        }
        if (saved === "default") return palette;
        if (!saved && palette !== "default") return palette;
        return prefersDark ? "dark" : palette;
      })();
      applyTheme(initial);
    };
    initTheme();

    const toggleHandler = () => {
      const isDark = root.dataset.theme === "dark";
      applyTheme(isDark ? palette : "dark");
    };
    desktopToggle?.addEventListener("click", toggleHandler);
    mobileToggle?.addEventListener("click", toggleHandler);

    const drawer = document.getElementById("mobile-drawer");
    const backdrop = document.getElementById("drawer-backdrop");
    const openBtn = document.getElementById("drawer-open");
    const drawerLinks = drawer?.querySelectorAll("a");
    const header = document.querySelector(".site-header");

    const syncHeaderState = () => {
      header?.classList.toggle("is-stuck", window.scrollY > 8);
    };

    const setDrawer = (open) => {
      header?.classList.toggle("is-drawer-open", open);
      if (drawer) {
        drawer.style.transform = open ? "translateX(0)" : "translateX(-100%)";
        drawer.classList.toggle("is-open", open);
      }
      if (openBtn) {
        openBtn.setAttribute("aria-expanded", open ? "true" : "false");
        openBtn.setAttribute("aria-label", open ? "Fermer le menu" : "Ouvrir le menu");
        openBtn.classList.toggle("is-active", open);
      }
      if (backdrop) {
        backdrop.style.opacity = open ? "1" : "0";
        backdrop.style.pointerEvents = open ? "auto" : "none";
        backdrop.classList.toggle("is-open", open);
      }
      document.body.classList.toggle("overflow-hidden", open);
    };

    openBtn?.addEventListener("click", () => setDrawer(openBtn.getAttribute("aria-expanded") !== "true"));
    backdrop?.addEventListener("click", () => setDrawer(false));
    drawerLinks?.forEach((link) => link.addEventListener("click", () => setDrawer(false)));
    window.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        setDrawer(false);
      }
    });

    window.addEventListener("scroll", syncHeaderState, { passive: true });

    // Initialize closed state
    setDrawer(false);
    syncHeaderState();
  })();
</script>
