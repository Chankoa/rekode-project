---
import { siteConfig } from "../../data/site-config";
import Icon from "../ui/Icon.astro";

const year = new Date().getFullYear();
const normalizedPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isContactPage = normalizedPath === "/contact";
const phoneHref = siteConfig.contact.phone.replace(/\s+/g, "");
---

<footer class="site-footer border-t border-(--border-soft)">
  <div class="footer-manifesto-wrap">
    <div
      class:list={[
        "footer-manifesto max-w-(--site-max-width) mx-auto px-4 py-10 md:py-12",
        { "footer-manifesto--compact": isContactPage },
      ]}
    >
      {!isContactPage && (
        <address class="footer-contact__details" aria-label="Coordonnées de REKODE">
          <a
            href={`mailto:${siteConfig.contact.email}`}
            class="footer-contact__line"
            aria-label={`Envoyer un e-mail à ${siteConfig.contact.email}`}
          >
            <Icon name="mail" />
            <span>{siteConfig.contact.email}</span>
          </a>

          <a
            href={`tel:${phoneHref}`}
            class="footer-contact__line"
            aria-label={`Appeler REKODE au ${siteConfig.contact.phone}`}
          >
            <Icon name="phone" />
            <span>{siteConfig.contact.phone}</span>
          </a>

          <p class="footer-contact__line footer-contact__line--static">
            <Icon name="pin" />
            <span>{siteConfig.contact.address}</span>
          </p>
        </address>
      )}

      <div class="footer-manifesto__aside">
        <div class="footer-manifesto__visual" aria-hidden="true">
          <div class="footer-manifesto__circle footer-manifesto__circle--outer"></div>
          <div class="footer-manifesto__circle footer-manifesto__circle--middle"></div>
          <div class="footer-manifesto__circle footer-manifesto__circle--inner"></div>
        </div>

        <div class="footer-manifesto__content">
          <a href="/" class="footer-contact__brand" aria-label={`Retour à l'accueil ${siteConfig.name}`}>
            <span class="footer-contact__brand-mark">
              {siteConfig.name}<span class="footer-contact__brand-dot">.</span>
            </span>
          </a>
          <p class="footer-manifesto__eyebrow">Clarifier,</p>
          <p class="footer-manifesto__eyebrow">Structurer,</p>
          <p class="footer-manifesto__eyebrow">Concevoir.</p>
        </div>
      </div>
    </div>
  </div>

  <div class="site-footer__meta relative max-w-(--site-max-width) mx-auto px-4 py-6 pr-16 md:pr-20">
    <p>© {year} {siteConfig.name}. Tous droits réservés.</p>
    <div class="site-footer__links">
      <a href="#">Mentions légales</a>
      <a href="#">Politique de confidentialité</a>
      <p>Conçu avec Astro</p>
    </div>

    <button
      type="button"
      class="site-footer__scroll-top"
      aria-label="Revenir en haut de page"
      title="Revenir en haut de page"
      data-scroll-top
    >
      <span aria-hidden="true">↑</span>
    </button>
  </div>
</footer>

<script is:inline>
  (() => {
    const button = document.querySelector('[data-scroll-top]');
    if (!button) return;
    button.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  })();
</script>

<style>
  .site-footer {
    background:
      radial-gradient(circle at 18% 26%, color-mix(in srgb, var(--accent-primary) 16%, transparent) 0, transparent 32%),
      radial-gradient(circle at 88% 18%, color-mix(in srgb, var(--accent-primary) 10%, transparent) 0, transparent 28%),
      var(--surface-bg);
    color: var(--text-muted);
  }

  .footer-manifesto-wrap {
    border-bottom: 1px solid color-mix(in srgb, var(--border-soft) 72%, transparent);
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--surface-muted) 82%, transparent), color-mix(in srgb, var(--surface-card) 72%, transparent)),
      var(--surface-card);
  }

  .footer-manifesto {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }

  .footer-manifesto__aside {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  .footer-manifesto__visual {
    position: relative;
    width: clamp(11rem, 23vw, 13.25rem);
    aspect-ratio: 1;
    margin-inline: auto;
    filter: drop-shadow(0 18px 28px color-mix(in srgb, var(--accent-primary) 14%, transparent));
  }

  .footer-manifesto__circle {
    position: absolute;
    border-radius: 999px;
    background: var(--accent-primary);
  }

  .footer-manifesto__circle--outer {
    inset: 12% auto auto 5%;
    width: 80%;
    aspect-ratio: 1;
    opacity: 0.18;
  }

  .footer-manifesto__circle--middle {
    inset: 23% auto auto 19%;
    width: 63%;
    aspect-ratio: 1;
    opacity: 0.34;
  }

  .footer-manifesto__circle--inner {
    inset: 45% auto auto 42%;
    width: 34%;
    aspect-ratio: 1;
    opacity: 0.82;
  }

  .footer-manifesto__content {
    display: grid;
    gap: 1.1rem;
    align-content: start;
  }

  .footer-contact__details {
    display: grid;
    gap: 0.8rem;
    margin: 0;
    padding-top: 1rem;
    font-size: 0.95rem;
    font-style: normal;
  }

  .footer-contact__brand {
    width: fit-content;
    text-decoration: none;
    line-height: 1;
  }

  .footer-contact__brand-mark {
    font-family: var(--font-heading);
    font-size: clamp(1.05rem, 0.95rem + 0.3vw, 1.25rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    color: var(--text-default);
  }

  .footer-contact__brand-dot {
    color: var(--accent-primary);
  }

  .footer-contact__line {
    display: inline-flex;
    align-items: start;
    gap: 0.75rem;
    max-width: 20rem;
    color: var(--text-default);
    text-decoration: none;
    line-height: 1.5;
  }

  .footer-contact__line--static {
    margin: 0;
  }

  .footer-contact__line :global(.icon) {
    flex: 0 0 auto;
    width: 1rem;
    height: 1rem;
    margin-top: 0.15rem;
    color: color-mix(in srgb, var(--text-muted) 86%, var(--accent-primary) 14%);
  }

  a.footer-contact__line:hover,
  a.footer-contact__line:focus-visible {
    color: var(--accent-primary-strong);
  }

  .footer-manifesto__eyebrow {
    margin: 0;
    font-size: 0.78rem;
    line-height: 1;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--accent-primary-strong) 66%, var(--text-default) 34%);
  }

  .site-footer__meta {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    font-size: 0.825rem;
  }

  .site-footer__meta p {
    margin: 0;
  }

  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
  }

  .site-footer__scroll-top {
    position: absolute;
    top: 50%;
    right: 1rem;
    display: inline-flex;
    width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    transform: translateY(-50%);
    border: 1px solid var(--border-soft);
    border-radius: 999px;
    background: var(--surface-muted);
    color: var(--text-strong);
    box-shadow: var(--shadow-sm);
    transition: background-color 160ms var(--ease-standard, ease);
  }

  .site-footer__scroll-top:hover,
  .site-footer__scroll-top:focus-visible {
    background: var(--surface-card);
  }

  @media (min-width: 768px) {
    .footer-manifesto {
      gap: 2.8rem;
    }

    .footer-manifesto__aside {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 2.4rem 3rem;
    }

    .footer-manifesto__visual {
      margin-inline: 0;
    }

    .footer-contact__details {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.9rem 2rem;
      padding: 0 0 2rem;
      border-bottom: 1px solid color-mix(in srgb, var(--border-soft) 52%, transparent);
    }

    .footer-contact__line:last-child {
      grid-column: 1 / -1;
    }

    .footer-manifesto--compact {
      max-width: 44rem;
    }

    .site-footer__meta {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      gap: 1rem 2rem;
    }

    .site-footer__links {
      justify-content: flex-end;
    }
  }

  @media (min-width: 1024px) {
    .footer-manifesto {
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
      gap: 3.5rem;
      align-items: start;
    }

    .footer-manifesto__aside {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 2.75rem;
      align-self: center;
    }

    .footer-contact__details {
      grid-template-columns: minmax(0, 1fr);
      align-content: start;
      min-width: 18rem;
      padding: 1rem clamp(2rem, 4vw, 4rem) 1rem 0;
      border-right: 1px solid color-mix(in srgb, var(--border-soft) 52%, transparent);
      border-bottom: 0;
    }

    .footer-contact__line:last-child {
      grid-column: auto;
    }

    .footer-manifesto--compact {
      grid-template-columns: minmax(0, 1fr);
      max-width: 44rem;
    }
  }

  @media (max-width: 767px) {
    .footer-manifesto__aside {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 1.5rem;
    }

    .footer-manifesto__visual {
      width: clamp(9.5rem, 43vw, 11rem);
      margin-inline: 0;
    }

    .footer-manifesto__content {
      align-self: center;
    }

    .footer-contact__details {
      padding-bottom: 2rem;
      border-bottom: 1px solid color-mix(in srgb, var(--border-soft) 52%, transparent);
    }

    .footer-manifesto--compact .footer-manifesto__aside {
      justify-content: center;
    }
  }

  @media (max-width: 420px) {
    .footer-manifesto__aside {
      grid-template-columns: minmax(0, 1fr);
    }

    .footer-manifesto__content {
      order: -1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-footer__scroll-top {
      transition: none;
    }
  }
</style>
