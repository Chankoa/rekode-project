---
import { siteConfig } from "../../data/site-config";

const year = new Date().getFullYear();
---

<footer class="site-footer border-t border-(--border-soft)">
  <div class="site-footer__inner max-w-(--site-max-width) mx-auto px-4 py-7 pr-16 md:pr-20">
    <a href="/" class="site-footer__brand" aria-label={`Retour à l'accueil ${siteConfig.name}`}>
      {siteConfig.name}<span aria-hidden="true">.</span>
    </a>

    <p>© {year} {siteConfig.name}. Tous droits réservés.</p>

    <div class="site-footer__links">
      <a href="#">Mentions légales</a>
      <a href="#">Politique de confidentialité</a>
      <p>Conçu avec Astro</p>
    </div>

    <button
      type="button"
      class="site-footer__scroll-top"
      aria-label="Revenir en haut de page"
      title="Revenir en haut de page"
      data-scroll-top
    >
      <span aria-hidden="true">↑</span>
    </button>
  </div>
</footer>

<script is:inline>
  (() => {
    const button = document.querySelector('[data-scroll-top]');
    if (!button) return;
    button.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  })();
</script>

<style>
  .site-footer {
    background:
      radial-gradient(circle at 18% 26%, color-mix(in srgb, var(--accent-primary) 10%, transparent) 0, transparent 32%),
      var(--surface-bg);
  }

  .site-footer__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  .site-footer__brand {
    width: fit-content;
    color: var(--text-default);
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    text-decoration: none;
  }

  .site-footer__brand span {
    color: var(--accent-primary);
  }

  .site-footer__inner p {
    margin: 0;
  }

  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem 1.25rem;
  }

  .site-footer__scroll-top {
    position: absolute;
    top: 50%;
    right: 1rem;
    display: inline-flex;
    width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    transform: translateY(-50%);
    border: 1px solid var(--border-soft);
    border-radius: 999px;
    background: var(--surface-muted);
    color: var(--text-strong);
    box-shadow: var(--shadow-sm);
    transition: background-color 160ms var(--ease-standard, ease);
  }

  .site-footer__scroll-top:hover,
  .site-footer__scroll-top:focus-visible {
    background: var(--surface-card);
  }

  @media (min-width: 768px) {
    .site-footer__inner {
      display: grid;
      grid-template-columns: auto auto minmax(0, 1fr);
      align-items: center;
      gap: 1rem 2rem;
    }

    .site-footer__links {
      justify-content: flex-end;
    }
  }
</style>
