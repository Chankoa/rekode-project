---
import type { ProjectItem } from "../../data/site-content";

interface Props {
  title?: string;
  intro?: string;
  projects: ProjectItem[];
}

const {
  title = "Projets sélectionnés",
  intro = "Des projets qui montrent à la fois le niveau d'exécution, la variété des contextes et la capacité à construire une base réutilisable.",
  projects,
} = Astro.props;
---

<section class="section-shell">
  <div class="max-w-5xl mx-auto px-4 space-y-8">
    <header class="section-header">
      <h2 class="text-2xl sm:text-3xl font-semibold">{title}</h2>
      <p class="text-[var(--color-muted)] text-sm sm:text-base">{intro}</p>
    </header>

    <div class="project-grid">
      {projects.map((project) => (
        <article class="card-elevated section-card section-card--project">
          <div class="space-y-3">
            <h3 class="text-lg font-semibold">{project.title}</h3>
            <p class="text-sm text-[var(--color-muted)]">{project.summary}</p>
          </div>

          <ul class="feature-list">
            {project.tags.map((tag) => (
              <li class="badge-pill">{tag}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>