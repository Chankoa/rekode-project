---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import type { ProjectItem } from "../../data/site-content";
import Icon from "../ui/Icon.astro";

interface Props {
  title?: string;
  intro?: string;
  projects: ProjectItem[];
  showProjectsLink?: boolean;
  variant?: "cards" | "case-studies";
}

const {
  title = "Quelques projets",
  intro = "Une sélection de projets pour montrer le niveau d'exécution, la précision de l'intégration et la variété des contextes traités.",
  projects,
  showProjectsLink = true,
  variant = "cards",
} = Astro.props;

const assetExtensionPattern = /\.(avif|webp|png|jpe?g)$/i;

const buildAssetMap = (modules: Record<string, { default: ImageMetadata }>) =>
  new Map(
    Object.entries(modules)
      .map(([path, asset]) => {
        const fileName = path.split("/").pop();
        const slug = fileName?.replace(assetExtensionPattern, "");

        return slug ? [slug, asset.default] : null;
      })
      .filter((entry): entry is [string, ImageMetadata] => Boolean(entry)),
  );

const projectThumbnailModules = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/projects/*.{avif,webp,png,jpg,jpeg}",
  { eager: true },
);

const projectLogoModules = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/projects/logos/*.{avif,webp,png,jpg,jpeg}",
  { eager: true },
);

const projectCaseStudyImageModules = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/projects/case-studies/*.{avif,webp,png,jpg,jpeg}",
  { eager: true },
);

const projectThumbnailMap = buildAssetMap(projectThumbnailModules);
const projectLogoMap = buildAssetMap(projectLogoModules);
const projectCaseStudyImageMap = buildAssetMap(projectCaseStudyImageModules);
---

<section class="section-shell">
  <div class="max-w-[var(--site-max-width)] mx-auto px-4 space-y-8">
    <header class="section-heading-row">
      <div class="section-header">
        <h2 class="text-2xl sm:text-3xl font-semibold">{title}</h2>
        <p class="text-[var(--color-muted)] text-sm sm:text-base">{intro}</p>
      </div>
      {showProjectsLink && (
        <a href="/projets" class="section-link">
          <span>Voir tous les projets</span>
          <Icon name="arrow" />
        </a>
      )}
    </header>

    {variant === "cards" ? (
      <div class="project-grid project-grid--projects">
        {projects.map((project) => {
          const thumbnail = projectThumbnailMap.get(project.slug);
          const logo = projectLogoMap.get(project.slug);
          const projectHref = `/projets#${project.slug}`;

          return (
            <article class={`project-card has-hover-fx project-card--${project.slug}`}>
              <a href={projectHref} class="project-card__link" aria-label={`Voir le projet ${project.title}`}>
                <div class="project-card__visual">
                  {thumbnail ? (
                    <Image
                      src={thumbnail}
                      alt={project.thumbnailAlt ?? `Apercu du projet ${project.title}`}
                      class="project-card__image"
                      widths={[480, 720, 960]}
                      sizes="(max-width: 767px) 100vw, (max-width: 1279px) 50vw, 33vw"
                      loading="lazy"
                      format="webp"
                    />
                  ) : (
                    <div class="project-card__screen project-card__screen--placeholder"></div>
                  )}

                  <div class="project-card__visual-overlay" aria-hidden="true"></div>

                  {logo && (
                    <div class="project-card__logo-badge">
                      <Image
                        src={logo}
                        alt={project.clientLogoAlt ?? `Logo ${project.title}`}
                        class="project-card__logo"
                        widths={[96, 144, 192]}
                        sizes="96px"
                        loading="lazy"
                        format="webp"
                      />
                    </div>
                  )}
                </div>

                <div class="project-card__content space-y-3">
                  <p class="project-card__meta">{project.meta}</p>
                  <h3 class="text-base font-semibold">{project.title}</h3>
                  <p class="text-sm text-[var(--color-muted)]">{project.summary}</p>
                  <p class="project-card__tags">{project.tags.join(" · ")}</p>
                </div>
              </a>
            </article>
          );
        })}
      </div>
    ) : (
      <div class="project-case-study-list">
        {projects.map((project) => {
          const thumbnail = projectThumbnailMap.get(project.slug);
          const logo = projectLogoMap.get(project.slug);
          const caseStudy = project.caseStudy;
          const caseStudyImage = projectCaseStudyImageMap.get(project.slug) ?? thumbnail;
          const overview = caseStudy?.overview;
          const highlights = overview?.highlights ?? [];
          const cta = caseStudy?.cta;
          const projectWebsiteHref = project.websiteHref;

          return (
            <article id={project.slug} class={`project-case-study project-card--${project.slug}`}>
              <div class="project-case-study__hero">
                <div class="project-case-study__media">
                  <div
                    class="project-case-study__visual"
                    style={caseStudyImage ? `--project-case-study-aspect-ratio: ${caseStudyImage.width} / ${caseStudyImage.height};` : undefined}
                  >
                    <p class="project-case-study__index" aria-hidden="true">{project.meta}</p>

                    <div class="project-case-study__frame">
                      {caseStudyImage ? (
                        <Image
                          src={caseStudyImage}
                          alt={project.thumbnailAlt ?? `Apercu du projet ${project.title}`}
                          class="project-case-study__image"
                          widths={[720, 1080, 1440]}
                          sizes="(max-width: 1023px) 100vw, 52vw"
                          loading="lazy"
                          format="webp"
                        />
                      ) : (
                        <div class="project-card__screen project-card__screen--placeholder"></div>
                      )}

                      <div class="project-card__visual-overlay" aria-hidden="true"></div>

                      {logo && (
                        <div class="project-card__logo-badge project-card__logo-badge--case-study">
                          <Image
                            src={logo}
                            alt={project.clientLogoAlt ?? `Logo ${project.title}`}
                            class="project-card__logo"
                            widths={[96, 144, 192]}
                            sizes="96px"
                            loading="lazy"
                            format="webp"
                          />
                        </div>
                      )}
                    </div>
                  </div>
                </div>

                <div class="project-case-study__content space-y-6">
                  <div class="project-case-study__header">
                    <div class="project-case-study__heading-row">
                      <div class="space-y-3">
                        <h3 class="text-2xl sm:text-3xl font-semibold">{project.title}</h3>
                        <p class="text-base sm:text-lg text-[var(--color-muted)] leading-relaxed">
                          {project.summary}
                        </p>
                        {projectWebsiteHref && (
                          <a
                            href={projectWebsiteHref}
                            class="project-case-study__site-link section-link"
                            target="_blank"
                            rel="noreferrer"
                          >
                            <span>{project.websiteLabel ?? "Voir le site"}</span>
                            <Icon name="arrow" />
                          </a>
                        )}
                      </div>
                    </div>

                    {overview && (
                      <dl class="project-case-study__overview" aria-label="Repères projet">
                        <div class="project-case-study__overview-item about-page__soft-rule">
                          <dt class="project-case-study__label">Rôle</dt>
                          <dd>{overview.role}</dd>
                        </div>
                        <div class="project-case-study__overview-item about-page__soft-rule">
                          <dt class="project-case-study__label">Livrables</dt>
                          <dd>{overview.deliverables}</dd>
                        </div>
                        <div class="project-case-study__overview-item about-page__soft-rule">
                          <dt class="project-case-study__label">Stack</dt>
                          <dd>{overview.stack}</dd>
                        </div>
                        {overview.timeline && (
                          <div class="project-case-study__overview-item about-page__soft-rule">
                            <dt class="project-case-study__label">Cadre</dt>
                            <dd>{overview.timeline}</dd>
                          </div>
                        )}
                      </dl>
                    )}

                    {cta && (
                      <a href={cta.href} class="project-case-study__cta section-link section-link--inline">
                        <span>{cta.label}</span>
                        <Icon name="arrow" />
                      </a>
                    )}
                  </div>
                </div>
              </div>

              <div class="project-case-study__sections">
                <section class="project-case-study__section about-page__soft-rule">
                  <p class="project-case-study__label">Contexte</p>
                  <p>{caseStudy?.context ?? project.summary}</p>
                </section>
                <section class="project-case-study__section about-page__soft-rule">
                  <p class="project-case-study__label">Objectif</p>
                  <p>{caseStudy?.objective ?? project.summary}</p>
                </section>
                <section class="project-case-study__section about-page__soft-rule">
                  <p class="project-case-study__label">Approche</p>
                  <p>{caseStudy?.approach ?? project.summary}</p>
                </section>
                <section class="project-case-study__section about-page__soft-rule">
                  <p class="project-case-study__label">Résultat</p>
                  <p>{caseStudy?.outcome ?? project.summary}</p>
                </section>
              </div>
            </article>
          );
        })}
      </div>
    )}
  </div>
</section>