---
import { contactContent } from "../../data/site-content";
import { siteConfig } from "../../data/site-config";
import Icon from "../ui/Icon.astro";

interface Props {
  title?: string;
  intro?: string;
  ctaLabel?: string;
  ctaHref?: string;
  compact?: boolean;
}

const {
  title = contactContent.title,
  intro = contactContent.intro,
  ctaLabel = contactContent.ctaLabel,
  ctaHref = contactContent.ctaHref,
  compact = false,
} = Astro.props;
---

<section class="section-shell" id="contact">
  {compact ? (
    <div class="max-w-(--site-max-width) mx-auto px-4">
      <div class="contact-band">
        <div class="contact-band__intro section-copy-stack">
          <h2 class="text-2xl sm:text-3xl font-semibold">{title}</h2>
          <p class="text-sm sm:text-base text-(--color-muted) leading-relaxed">{intro}</p>
          <a href={ctaHref} class="contact-band__cta" aria-label={ctaLabel}>
            <Icon name="arrow" />
          </a>
        </div>

        <div class="contact-band__details">
          {siteConfig.contact.email && (
            <a href={`mailto:${siteConfig.contact.email}`} class="contact-line">
              <Icon name="mail" />
              <span>{siteConfig.contact.email}</span>
            </a>
          )}
          {siteConfig.contact.phone && (
            <a href={`tel:${siteConfig.contact.phone}`} class="contact-line">
              <Icon name="phone" />
              <span>{siteConfig.contact.phone}</span>
            </a>
          )}
          {siteConfig.contact.address && (
            <p class="contact-line">
              <Icon name="pin" />
              <span>{siteConfig.contact.address}</span>
            </p>
          )}
        </div>
      </div>
    </div>
  ) : (
    <div class="max-w-(--site-max-width) mx-auto px-4 grid gap-10 md:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] items-start">
      <div class="section-copy-stack">
        <h2 class="text-2xl sm:text-3xl font-semibold">{title}</h2>
        <p class="text-sm sm:text-base text-(--color-muted) leading-relaxed">{intro}</p>
        <div class="space-y-2 text-sm text-(--color-muted)">
          {siteConfig.contact.phone && (
            <p class="contact-line"><Icon name="phone" /> <a href={`tel:${siteConfig.contact.phone}`} class="hover:text-(--color-accent)">{siteConfig.contact.phone}</a></p>
          )}
          {siteConfig.contact.email && (
            <p class="contact-line"><Icon name="mail" /> <a href={`mailto:${siteConfig.contact.email}`} class="hover:text-(--color-accent)">{siteConfig.contact.email}</a></p>
          )}
          {siteConfig.contact.address && <p class="contact-line"><Icon name="pin" /> <span>{siteConfig.contact.address}</span></p>}
        </div>
      </div>

      <form
        name="contact"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        action="/merci"
        class="contact-form card-elevated section-card text-sm"
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="u-sr-only">
          <label>
            Ne pas remplir ce champ si vous êtes humain
            <input name="bot-field" tabindex="-1" autocomplete="off" />
          </label>
        </p>

        <div class="contact-form__field">
          <label for="name" class="u-sr-only">Vos nom et prenom</label>
          <input
            id="name"
            name="name"
            required
            autocomplete="name"
            placeholder="Vos nom et prenom*"
            class="contact-form__input has-focus-fx"
          />
        </div>

        <div class="contact-form__field">
          <label for="email" class="u-sr-only">Votre adresse mail</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            autocomplete="email"
            inputmode="email"
            placeholder="Votre adresse mail*"
            class="contact-form__input has-focus-fx"
          />
        </div>

        <div class="contact-form__field">
          <label for="message" class="u-sr-only">Votre message</label>
          <textarea
            id="message"
            name="message"
            rows="4"
            required
            placeholder="Votre message"
            class="contact-form__input contact-form__input--textarea has-focus-fx"
          ></textarea>
        </div>

        <div class="contact-form__actions">
          <button type="submit" class="contact-form__submit btn-primary is-rounded justify-center">
            Envoyer
          </button>
        </div>
      </form>
    </div>
  )}
</section>