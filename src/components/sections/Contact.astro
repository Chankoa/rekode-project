---
import { contactContent } from "../../data/site-content";
import { siteConfig } from "../../data/site-config";
import Icon from "../ui/Icon.astro";

interface Props {
  title?: string;
  intro?: string;
}

const {
  title = contactContent.title,
  intro = contactContent.intro,
} = Astro.props;
---

<section class="section-shell" id="contact">
    <div class="max-w-(--site-max-width) mx-auto px-4 grid gap-10 md:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] items-start">
      <div class="section-copy-stack">
        <h1 class="text-2xl sm:text-3xl font-semibold">{title}</h1>
        <p class="text-sm sm:text-base text-(--color-muted) leading-relaxed">{intro}</p>
        <div class="space-y-2 text-sm text-(--color-muted)">
          {siteConfig.contact.phone && (
            <p class="contact-line"><Icon name="phone" /> <a href={`tel:${siteConfig.contact.phone}`} class="hover:text-(--color-accent)">{siteConfig.contact.phone}</a></p>
          )}
          {siteConfig.contact.email && (
            <p class="contact-line"><Icon name="mail" /> <a href={`mailto:${siteConfig.contact.email}`} class="hover:text-(--color-accent)">{siteConfig.contact.email}</a></p>
          )}
          {siteConfig.contact.address && <p class="contact-line"><Icon name="pin" /> <span>{siteConfig.contact.address}</span></p>}
        </div>
      </div>

      <form
        method="POST"
        action="/api/contact"
        class="contact-form card-elevated section-card text-sm"
        data-contact-form
      >
        <p class="contact-form__honeypot" aria-hidden="true" inert>
          <label>
            Ne pas remplir ce champ si vous êtes humain
            <input name="website" tabindex="-1" autocomplete="off" />
          </label>
        </p>

        <div class="contact-form__field">
          <label for="name" class="u-sr-only">Vos nom et prenom</label>
          <input
            id="name"
            name="name"
            required
            minlength="2"
            maxlength="120"
            autocomplete="name"
            placeholder="Vos nom et prenom*"
            class="contact-form__input has-focus-fx"
          />
        </div>

        <div class="contact-form__field">
          <label for="email" class="u-sr-only">Votre adresse mail</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            maxlength="254"
            autocomplete="email"
            inputmode="email"
            placeholder="Votre adresse mail*"
            class="contact-form__input has-focus-fx"
          />
        </div>

        <div class="contact-form__field">
          <label for="message" class="u-sr-only">Votre message</label>
          <textarea
            id="message"
            name="message"
            rows="4"
            required
            minlength="10"
            maxlength="10000"
            placeholder="Votre message"
            class="contact-form__input contact-form__input--textarea has-focus-fx"
          ></textarea>
        </div>

        <div class="contact-form__actions">
          <p class="contact-form__status" data-form-status role="status" aria-live="polite" aria-atomic="true"></p>
          <button type="submit" class="contact-form__submit btn-primary is-rounded justify-center" data-submit-button>
            Envoyer
          </button>
        </div>
      </form>
    </div>
</section>

<script>
  type ContactResponse = {
    ok?: boolean;
    message?: string;
    errors?: Partial<Record<"name" | "email" | "message", string>>;
  };

  document.querySelectorAll<HTMLFormElement>("[data-contact-form]").forEach((form) => {
    const submitButton = form.querySelector<HTMLButtonElement>("[data-submit-button]");
    const status = form.querySelector<HTMLElement>("[data-form-status]");

    if (!submitButton || !status) return;

    const defaultButtonLabel = submitButton.textContent?.trim() || "Envoyer";
    let isSubmitting = false;

    const announce = (message: string, state: "pending" | "success" | "error") => {
      status.dataset.state = state;
      status.setAttribute("role", state === "error" ? "alert" : "status");
      status.textContent = message;
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (isSubmitting || !form.reportValidity()) return;

      isSubmitting = true;
      submitButton.disabled = true;
      submitButton.textContent = "Envoi…";
      form.setAttribute("aria-busy", "true");
      form.querySelectorAll("[aria-invalid='true']").forEach((field) => field.removeAttribute("aria-invalid"));
      announce("Envoi de votre message en cours…", "pending");

      try {
        const response = await fetch(form.action, {
          method: "POST",
          headers: { Accept: "application/json" },
          body: new FormData(form),
        });
        const payload = (await response.json()) as ContactResponse;

        if (!response.ok || !payload.ok) {
          const firstInvalidField = (Object.keys(payload.errors ?? {}) as Array<keyof NonNullable<ContactResponse["errors"]>>)[0];
          let validationMessage = "";
          if (firstInvalidField) {
            validationMessage = payload.errors?.[firstInvalidField] ?? "";
            const field = form.elements.namedItem(firstInvalidField);
            if (field instanceof HTMLElement) {
              field.setAttribute("aria-invalid", "true");
              field.focus();
            }
          }
          announce(validationMessage || payload.message || "Votre message n’a pas pu être envoyé. Réessayez plus tard.", "error");
          return;
        }

        form.reset();
        announce(payload.message || "Votre message a bien été envoyé.", "success");
      } catch {
        announce("Votre message n’a pas pu être envoyé. Vérifiez votre connexion puis réessayez.", "error");
      } finally {
        isSubmitting = false;
        submitButton.disabled = false;
        submitButton.textContent = defaultButtonLabel;
        form.removeAttribute("aria-busy");
      }
    });
  });
</script>
