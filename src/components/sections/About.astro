---
import { Image } from "astro:assets";
import { aboutContent, type AboutHighlightItem } from "../../data/site-content";
import aboutPortrait from "../../assets/about-chandra-josephus.webp";
import Icon from "../ui/Icon.astro";

interface Props {
  eyebrow?: string;
  title?: string;
  text?: string;
  points?: AboutHighlightItem[];
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  eyebrow = aboutContent.eyebrow,
  title = aboutContent.title,
  text = aboutContent.text,
  points = aboutContent.points,
  ctaLabel = aboutContent.ctaLabel,
  ctaHref = aboutContent.ctaHref,
} = Astro.props;
---

<section class="section-shell">
  <div class="max-w-(--site-max-width) mx-auto px-4">
    <div class="about-preview">
      <div class="about-preview__media">
        <Image
          src={aboutPortrait}
          alt="Portrait en noir et blanc"
          class="about-preview__portrait"
          widths={[480, 720, 960]}
          sizes="(max-width: 767px) 100vw, 30vw"
          loading="lazy"
          format="webp"
        />
      </div>

      <header class="about-preview__header section-header section-header--split">
        <p class="section-label">{eyebrow}</p>
        <h2 class="text-2xl sm:text-3xl font-semibold">{title}</h2>
      </header>

      <div class="about-preview__body">
        <div class="about-preview__content">
          <div class="about-preview__copy">
            <p class="text-sm sm:text-base text-(--color-muted) leading-relaxed">{text}</p>
          </div>

          <a href={ctaHref} class="section-link section-link--inline">
            <span>{ctaLabel}</span>
            <Icon name="arrow" />
          </a>
        </div>

        {points.length > 0 && (
          <aside class="about-preview__highlights" aria-label="Repères">
            <p class="about-page__hero-aside-label pb-2">Repères</p>
            <ul class="about-highlight-list">
              {points.map((point) => (
                <li>
                  <span class="about-highlight-list__icon">
                    <Icon name={point.icon} />
                  </span>
                  <span>{point.label}</span>
                </li>
              ))}
            </ul>
          </aside>
        )}
      </div>
    </div>
  </div>
</section>