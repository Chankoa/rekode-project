---
import { processContent, type ProcessStep } from "../../data/site-content";
import Icon from "../ui/Icon.astro";

interface Props {
  title?: string;
  intro?: string;
  steps: ProcessStep[];
}

const {
  title = processContent.title,
  intro = processContent.intro,
  steps,
} = Astro.props;
---

<section class="section-shell">
  <div class="approach-page section-stack--airy max-w-(--site-max-width) mx-auto px-4">
    <header class="section-header">
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-semibold">{title}</h2>
      <p class="text-(--color-muted) text-sm sm:text-base leading-relaxed">{intro}</p>
    </header>

    <ol class="process-grid">
      {steps.map((step, index) => (
        <li class="process-step">
          <span class="process-step__index">0{index + 1}</span>
          <span class="process-step__icon has-hover-fx"><Icon name={step.icon} /></span>
          <h3 class="text-base sm:text-lg font-semibold">{step.title}</h3>
          <p class="text-sm text-(--color-muted) leading-relaxed">{step.description}</p>
        </li>
      ))}
    </ol>
  </div>
</section>