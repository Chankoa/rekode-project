---
import type { ProcessStep } from "../../data/site-content";
import Icon from "../ui/Icon.astro";

interface Props {
  title?: string;
  intro?: string;
  steps: ProcessStep[];
}

const {
  title = "Une approche simple et humaine",
  intro = "Une méthode lisible, sans mise en scène inutile : comprendre, structurer, concevoir, intégrer, mettre en ligne.",
  steps,
} = Astro.props;
---

<section class="section-shell">
  <div class="max-w-[var(--site-max-width)] mx-auto px-4 space-y-8">
    <header class="section-header">
      <h2 class="text-2xl sm:text-3xl font-semibold">{title}</h2>
      <p class="text-[var(--color-muted)] text-sm sm:text-base">{intro}</p>
    </header>

    <ol class="process-grid">
      {steps.map((step, index) => (
        <li class="process-step">
          <span class="process-step__index">0{index + 1}</span>
          <span class="process-step__icon has-hover-fx"><Icon name={step.icon as any} /></span>
          <h3 class="text-base font-semibold">{step.title}</h3>
          <p class="text-sm text-[var(--color-muted)]">{step.description}</p>
        </li>
      ))}
    </ol>
  </div>
</section>