---
import type { ProcessStep } from "../../data/site-content";

interface Props {
  title?: string;
  intro?: string;
  steps: ProcessStep[];
}

const {
  title = "Approche",
  intro = "Une méthode simple: poser une structure claire, faire les bons arbitrages techniques et garder de la place pour l'évolution.",
  steps,
} = Astro.props;
---

<section class="section-shell">
  <div class="max-w-5xl mx-auto px-4 space-y-8">
    <header class="section-header">
      <h2 class="text-2xl sm:text-3xl font-semibold">{title}</h2>
      <p class="text-[var(--color-muted)] text-sm sm:text-base">{intro}</p>
    </header>

    <ol class="process-grid">
      {steps.map((step, index) => (
        <li class="card-elevated section-card section-card--process">
          <span class="badge-pill">0{index + 1}</span>
          <h3 class="text-base font-semibold">{step.title}</h3>
          <p class="text-sm text-[var(--color-muted)]">{step.description}</p>
        </li>
      ))}
    </ol>
  </div>
</section>