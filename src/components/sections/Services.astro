---
import { servicesContent, type ServiceItem } from "../../data/site-content";
import Icon from "../ui/Icon.astro";

interface Props {
  title?: string;
  intro?: string;
  services: ServiceItem[];
}

const {
  title = servicesContent.title,
  intro = servicesContent.intro,
  services,
} = Astro.props;
---

<section class="section-shell">
  <div class="services-page section-stack--airy max-w-(--site-max-width) mx-auto px-4">
    <header class="section-heading-row">
      <div class="section-header">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-semibold">{title}</h2>
        <p class="text-(--color-muted) text-sm sm:text-base leading-relaxed">{intro}</p>
      </div>
    </header>

    <div class="service-grid">
      {services.map((service) => (
        <article class="service-item u-soft-rule">
          <span class="service-item__icon"><Icon name={service.icon} /></span>
          <h3 class="text-base sm:text-lg font-semibold">{service.title}</h3>
          <p class="text-sm text-(--color-muted) leading-relaxed">{service.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>