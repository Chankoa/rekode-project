---
import type { ServiceItem } from "../../data/site-content";

interface Props {
  title?: string;
  intro?: string;
  services: ServiceItem[];
}

const {
  title = "Services",
  intro = "Des prestations cadrées pour garder un projet lisible, autant côté contenu que côté intégration.",
  services,
} = Astro.props;
---

<section class="section-shell">
  <div class="max-w-5xl mx-auto px-4 space-y-8">
    <header class="section-header">
      <h2 class="text-2xl sm:text-3xl font-semibold">{title}</h2>
      <p class="text-[var(--color-muted)] text-sm sm:text-base">{intro}</p>
    </header>

    <div class="project-grid project-grid--services">
      {services.map((service) => (
        <article class="card-elevated section-card">
          <p class="text-xs uppercase tracking-[0.18em] text-[var(--color-muted)]">{service.highlight}</p>
          <h3 class="text-base font-semibold">{service.title}</h3>
          <p class="text-sm text-[var(--color-muted)]">{service.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>