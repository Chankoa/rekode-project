---
import type { ServiceItem } from "../../data/site-content";
import Icon from "../ui/Icon.astro";

interface Props {
  title?: string;
  intro?: string;
  services: ServiceItem[];
}

const {
  title = "Ce que je peux faire pour vous",
  intro = "Des prestations structurées pour produire un site juste, rapide et facile à faire vivre.",
  services,
} = Astro.props;
---

<section class="section-shell">
  <div class="max-w-[var(--site-max-width)] mx-auto px-4 space-y-8">
    <header class="section-heading-row">
      <div class="section-header">
        <h2 class="text-2xl sm:text-3xl font-semibold">{title}</h2>
        <p class="text-[var(--color-muted)] text-sm sm:text-base">{intro}</p>
      </div>
    </header>

    <div class="service-grid">
      {services.map((service) => (
        <article class="service-item has-hover-fx">
          <span class="service-item__icon"><Icon name={service.icon as any} /></span>
          <h3 class="text-base font-semibold">{service.title}</h3>
          <p class="text-sm text-[var(--color-muted)]">{service.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>