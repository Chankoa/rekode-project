---
import { Image } from "astro:assets";
import { siteConfig } from "../../data/site-config";
import { heroContent, type HeroTitlePart } from "../../data/site-content";
import heroImage from "../../assets/home/hero.webp";
import CircleBadge from "../ui/CircleBadge.astro";
import Icon from "../ui/Icon.astro";

type FeatureIconName = "bolt" | "pen" | "code" | "ear";

interface FeatureItem {
  label: string;
  icon?: FeatureIconName;
}

interface Props {
  eyebrow?: string;
  titleParts?: HeroTitlePart[];
  subtitle?: string;
  ctaLabel?: string;
  ctaHref?: string;
  secondaryCtaLabel?: string;
  secondaryCtaHref?: string;
  supportingLabel?: string;
  supportingText?: string;
  features?: FeatureItem[];
}

const {
  eyebrow = heroContent.eyebrow,
  titleParts = heroContent.titleParts,
  subtitle = heroContent.subtitle ?? siteConfig.baseline,
  ctaLabel = heroContent.ctaLabel,
  ctaHref = heroContent.ctaHref,
  secondaryCtaLabel = heroContent.secondaryCtaLabel,
  secondaryCtaHref = heroContent.secondaryCtaHref,
  supportingLabel = heroContent.supportingLabel,
  supportingText = heroContent.supportingText,
  features = [
    { label: "Clarification", icon: "bolt" },
    { label: "Création web", icon: "pen" },
    { label: "Transmission", icon: "code" },
    { label: "Accompagnement", icon: "ear" },
  ],
} = Astro.props;

const fallbackIcons: FeatureIconName[] = ["bolt", "pen", "code", "ear"];
---

<section class="hero section-shell">
  <div class="hero__inner max-w-(--site-max-width) mx-auto px-4 grid gap-10 md:grid-cols-[minmax(0,1.2fr)_minmax(22rem,1fr)] items-center">
    <div class="space-y-6">
      <p class="hero__eyebrow section-label text-(--color-muted)">
        {eyebrow}
      </p>
      <h1 class="hero__title pb-(--space-4) font-bold tracking-tight">
        {titleParts.map((part) => (
          <span class:list={{
            "u-text-gradient": part.highlight,
            "text-(--accent-primary)": part.accent,
          }}>
            {part.text}
          </span>
        ))}
      </h1>
      {subtitle && (
        <p class="hero__summary text-base sm:text-lg text-(--color-muted) max-w-xl pb-(--space-4)">
          {subtitle}
        </p>
      )}
      <div class="hero__actions pt-2">
        <a href={ctaHref} class="btn-primary">
          {ctaLabel}
        </a>
        <a href={secondaryCtaHref} class="btn-secondary">
          {secondaryCtaLabel}
        </a>
      </div>

      <ul class="hero__features">
        {features.map((feature, index) => (
          <li>
            <span class="hero__feature-icon">
              <Icon name={feature.icon ?? fallbackIcons[index % fallbackIcons.length]} />
            </span>
            <span>{feature.label}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="hero__visual relative md:p-8">
      <div class="hero__visual-frame card-elevated">
        <Image
          src={heroImage}
          alt="Vue de montagne au lever du soleil"
          class="hero__image"
          widths={[480, 720, 960]}
          sizes="(max-width: 767px) 100vw, 40vw"
          loading="eager"
          format="webp"
        />
      </div>
      <CircleBadge class="hero__badge" />
      <div class="hero__panel hidden">
        <p class="text-sm uppercase tracking-[0.2em] text-(--color-muted) mb-3">
          {supportingLabel}
        </p>
        <p class="text-sm sm:text-base leading-relaxed">
          {supportingText}
        </p>
      </div>
    </div>
  </div>
</section>
