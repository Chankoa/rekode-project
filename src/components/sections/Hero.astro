---
import { Image } from "astro:assets";
import { siteConfig } from "../../data/site-config";
import type { HeroTitlePart } from "../../data/site-content";
import heroImage from "../../assets/home/hero.webp";
import CircleBadge from "../ui/CircleBadge.astro";

interface FeatureItem {
  label: string;
}

interface Props {
  eyebrow?: string;
  titleParts: HeroTitlePart[];
  subtitle?: string;
  ctaLabel?: string;
  ctaHref?: string;
  secondaryCtaLabel?: string;
  secondaryCtaHref?: string;
  supportingLabel?: string;
  supportingText?: string;
  features?: FeatureItem[];
}

const {
  eyebrow = "Site vitrine",
  titleParts = [{ text: "Des sites web clairs, pensés pour des humains." }],
  subtitle = siteConfig.baseline,
  ctaLabel = "Nous contacter",
  ctaHref = "/contact",
  secondaryCtaLabel = "Voir les projets",
  secondaryCtaHref = "/projets",
  supportingLabel = "Approche",
  supportingText = "Un site clair, efficace, documenté, et suffisamment simple pour rester facile à reprendre après livraison.",
  features = [
    { label: "Sites rapides" },
    { label: "UX & design" },
    { label: "Intégration propre" },
    { label: "Accompagnement" },
  ],
} = Astro.props;
---

<section class="hero">
  <div class="hero__inner max-w-[var(--site-max-width)] mx-auto px-4 grid gap-10 md:grid-cols-[minmax(0,1.2fr)_minmax(22rem,1fr)] items-center">
    <div class="space-y-6">
      <span class="hero__eyebrow text-[var(--color-muted)]">
        {eyebrow}
      </span>
      <h1 class="hero__title font-bold tracking-tight">
        {titleParts.map((part) => (
          <span class:list={{
            "u-text-gradient": part.highlight,
            "text-[var(--accent-primary)]": part.accent,
          }}>
            {part.text}
          </span>
        ))}
      </h1>
      {subtitle && (
        <p class="hero__summary text-base sm:text-lg text-[var(--color-muted)] max-w-xl">
          {subtitle}
        </p>
      )}
      <div class="hero__actions pt-2">
        <a href={ctaHref} class="btn-primary">
          {ctaLabel}
        </a>
        <a href={secondaryCtaHref} class="btn-secondary">
          {secondaryCtaLabel}
        </a>
      </div>

      <ul class="hero__features">
        {features.map((feature) => (
          <li>
            <span>{feature.label}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="hero__visual relative p-6 md:p-8">
      <div class="hero__visual-frame card-elevated">
        <Image
          src={heroImage}
          alt="Vue de montagne au lever du soleil"
          class="hero__image"
          widths={[480, 720, 960]}
          sizes="(max-width: 767px) 100vw, 40vw"
          loading="eager"
          format="webp"
        />
      </div>
      <CircleBadge class="hero__badge" />
      <div class="hero__panel hidden">
        <p class="text-sm uppercase tracking-[0.2em] text-[var(--color-muted)] mb-3">
          {supportingLabel}
        </p>
        <p class="text-sm sm:text-base leading-relaxed">
          {supportingText}
        </p>
      </div>
    </div>
  </div>
</section>
