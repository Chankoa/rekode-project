---
interface Props {
  name:
    | "bolt"
    | "document"
    | "code"
    | "leaf"
    | "monitor"
    | "refresh"
    | "wordpress"
    | "cap"
    | "ear"
    | "spark"
    | "pen"
    | "rocket"
    | "mail"
    | "phone"
    | "pin"
    | "quote"
    | "arrow"
    | "star"
    | "heart"
    | "mountain"
    | "shopping"
    | "shoppingBag";
  class?: string;
}

const { name, class: className = "" } = Astro.props;
---

<span class={`icon ${className}`.trim()} aria-hidden="true">
  {name === "bolt" && (
    <svg viewBox="0 0 24 24"><path d="M13 2L4 14h7l-1 8 10-13h-7l1-7z" /></svg>
  )}
  {name === "document" && (
    <svg viewBox="0 0 24 24"><rect x="4" y="3" width="16" height="18" rx="2" /><path d="M8 8h8" /><path d="M8 12h5" /><path d="M8 16h8" /></svg>
  )}
  {name === "code" && (
    <svg viewBox="0 0 24 24"><path d="M8 9l-4 3 4 3" /><path d="M16 9l4 3-4 3" /><path d="M14 5l-4 14" /></svg>
  )}
  {name === "leaf" && (
    <svg viewBox="0 0 24 24"><path d="M20 4C12 5 6 11 5 20c7-1 13-7 15-16z" /><path d="M9 15c2-2 4-4 7-6" /></svg>
  )}
  {name === "monitor" && (
    <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="12" rx="2" /><path d="M8 20h8" /><path d="M12 16v4" /></svg>
  )}
  {name === "refresh" && (
    <svg viewBox="0 0 24 24"><path d="M21 12a9 9 0 0 1-15.4 6.4" /><path d="M3 12A9 9 0 0 1 18.4 5.6" /><path d="M18 2v4h4" /><path d="M6 22v-4H2" /></svg>
  )}
  {name === "wordpress" && (
    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M6.5 8h2l3.5 9 2-5" /><path d="M10.5 8h6" /><path d="M15.5 8l2 9" /></svg>
  )}
  {name === "cap" && (
    <svg viewBox="0 0 24 24"><path d="M3 7l9-4 9 4-9 4-9-4z" /><path d="M7 10v5c0 2 2.5 4 5 4s5-2 5-4v-5" /></svg>
  )}
  {name === "ear" && (
    <svg viewBox="0 0 24 24"><path d="M6 11a6 6 0 0 1 12 0c0 4-4 5-4 8a2 2 0 0 1-4 0" /><path d="M10 11a2 2 0 0 1 4 0c0 2-2 2.5-2 5" /></svg>
  )}
  {name === "spark" && (
    <svg viewBox="0 0 24 24"><path d="M12 2l2.5 4.5L19 9l-4.5 2.5L12 16l-2.5-4.5L5 9l4.5-2.5L12 2z" /><path d="M4 18h16" /><path d="M7 22h10" /></svg>
  )}
  {name === "pen" && (
    <svg viewBox="0 0 24 24"><path d="M4 20l4.5-1 10-10a2.1 2.1 0 0 0-3-3l-10 10L4 20z" /><path d="M14 7l3 3" /></svg>
  )}
  {name === "rocket" && (
    <svg viewBox="0 0 24 24"><path d="M12 2l3 7 7 3-7 3-3 7-3-7-7-3 7-3 3-7z" /><path d="M12 8v4l3 1" /></svg>
  )}
  {name === "mail" && (
    <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 7l9 6 9-6" /></svg>
  )}
  {name === "phone" && (
    <svg viewBox="0 0 24 24"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1A19.5 19.5 0 0 1 5.2 12 19.8 19.8 0 0 1 2.1 3.4 2 2 0 0 1 4.1 1h3a2 2 0 0 1 2 1.7l.5 3a2 2 0 0 1-.5 1.7L8 8.5a16 16 0 0 0 7.5 7.5l1.1-1.1a2 2 0 0 1 1.7-.5l3 .5a2 2 0 0 1 1.7 2z" /></svg>
  )}
  {name === "pin" && (
    <svg viewBox="0 0 24 24"><path d="M12 21s7-5.3 7-12a7 7 0 0 0-14 0c0 6.7 7 12 7 12z" /><circle cx="12" cy="9" r="2.5" /></svg>
  )}
  {name === "quote" && (
    <svg viewBox="0 0 24 24"><path d="M9.5 7.5c-2.7 1-4.5 3.2-4.5 6.3 0 2.7 1.8 4.7 4.3 4.7 2.3 0 4.1-1.8 4.1-4 0-2.3-1.6-3.8-3.7-3.8h-.6c.3-1.4 1.3-2.6 2.9-3.3L9.5 7.5z" /><path d="M18.5 7.5c-2.7 1-4.5 3.2-4.5 6.3 0 2.7 1.8 4.7 4.3 4.7 2.3 0 4.1-1.8 4.1-4 0-2.3-1.6-3.8-3.7-3.8h-.6c.3-1.4 1.3-2.6 2.9-3.3l-2.5.1z" /></svg>
  )}
  {name === "arrow" && (
    <svg viewBox="0 0 24 24"><path d="M5 12h14" /><path d="M13 6l6 6-6 6" /></svg>
  )}
  {name === "star" && (
    <svg viewBox="0 0 24 24"><path d="M12 3.5l2.7 5.47 6.03.88-4.36 4.24 1.03 5.99L12 17.25l-5.4 2.83 1.03-5.99L3.27 9.85l6.03-.88L12 3.5z" /></svg>
  )}
  {name === "heart" && (
    <svg viewBox="0 0 24 24"><path d="M12 20s-7-4.35-7-10a4 4 0 0 1 7-2.65A4 4 0 0 1 19 10c0 5.65-7 10-7 10z" /></svg>
  )}
  {name === "mountain" && (
    <svg viewBox="0 0 24 24"><path d="M3 19l6.5-9 3.5 4 3-4 5 9" /><path d="M14 6l1.5-2L17 6" /></svg>
  )}
  {(name === "shopping" || name === "shoppingBag") && (
    <svg viewBox="0 0 24 24"><path d="M6.5 8.5h11l1 11h-13l1-11z" /><path d="M9 8.5a3 3 0 0 1 6 0" /><path d="M9.5 13h5" /></svg>
  )}

</span>
